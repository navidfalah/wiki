# Root-context builds (backend/Dockerfile) only need backend/ and compiler/.
# Everything mutable or huge is mounted as a volume at runtime -- keeping it
# out of the build context makes builds faster and images smaller.
.git
.github
.claude
.env
.env.*
**/node_modules
**/__pycache__
**/*.pyc
data
wiki-app
frontend
documentation
docker
backend/dist
backend/src/**/*.test.ts
compiler/.venv
compiler/temp_output
compiler/tests
compiler/scripts
*.md
