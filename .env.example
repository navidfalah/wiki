# LLM for compiler (extraction, synthesis, linking, image captioning). Use OpenAI or Gemini.
# Image files under data/raw/ are captioned via a vision-capable chat completion —
# both defaults below (gpt-4o-mini, gemini-2.5-flash) support this; if you swap to
# a text-only model, image ingestion will fail (text/email/file sources are unaffected).

# --- OpenAI (default) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (OpenAI-compatible) ---
# Get a key: https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# --- Local LLM via Ollama (OpenAI-compatible; no cost, no external API) ---
# docker compose --profile local-llm up   (see docker-compose.yml + the
# `ollama` service, and documentation/33-docker-and-local-llm.md)
# The API key can be any non-empty string — Ollama doesn't check it, but
# the OpenAI SDK requires one to be set.
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_MODEL=llama3.2
# Used by the retrieval/embedding pipeline (hybrid_retrieval.py, task #5) —
# needs `nomic-embed-text` (or another embedding model) pulled in the
# ollama container; OLLAMA_EMBED_MODEL in docker-compose.yml controls that.
# OPENAI_EMBEDDING_MODEL=nomic-embed-text
