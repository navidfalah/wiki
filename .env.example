# LLM for compiler (extraction, synthesis, linking, image captioning, audio
# transcription). Use OpenAI or Gemini.
# Image files under data/raw/ are captioned via a vision-capable chat completion —
# both defaults below (gpt-4o-mini, gemini-2.5-flash) support this; if you swap to
# a text-only model, image ingestion will fail (text/email/file sources are unaffected).
# Audio files are transcribed via a separate speech-to-text model (see
# OPENAI_TRANSCRIPTION_MODEL below) and degrade gracefully -- rather than
# failing the compile -- if that endpoint isn't available.

# --- OpenAI (default) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (OpenAI-compatible) ---
# Get a key: https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# --- Local LLM: Gemma, run in-process by llama.cpp inside its own
# container (no Ollama, no separate model-management daemon) ---
# docker compose --profile local-llm up   (see docker-compose.yml + the
# `local-llm` service, docker/local-llm/, and
# documentation/33-docker-and-local-llm.md)
# The API key can be any non-empty string — llama.cpp's server doesn't
# check it, but the OpenAI SDK requires one to be set.
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://local-llm:8080/v1
# OPENAI_MODEL=gemma-2-2b-it    # must match MODEL_ALIAS below

# Which GGUF file the local-llm container downloads from Hugging Face on
# first start (see docker/local-llm/entrypoint.sh) — defaults to a real,
# verified repo: bartowski/gemma-2-2b-it-GGUF's Q5_K_M quant (~1.9GB).
# LOCAL_LLM_MODEL_REPO=bartowski/gemma-2-2b-it-GGUF
# LOCAL_LLM_MODEL_FILE=gemma-2-2b-it-Q5_K_M.gguf
# LOCAL_LLM_MODEL_ALIAS=gemma-2-2b-it
# HF_TOKEN=                     # only needed if MODEL_REPO is a gated Hugging Face repo

# This local-llm container serves chat completions only (extraction/
# synthesis/chat) — it does not currently serve embeddings, so
# hybrid_retrieval.py's embedding tier (task #5) and the vector-store
# wiring (task #11) still need OPENAI_EMBEDDING_MODEL pointed at OpenAI or
# Gemini's embeddings endpoint even when using the local LLM for chat.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Same story for audio: this local-llm container doesn't serve a
# transcriptions endpoint either, so audio files fall back to a metadata-only
# chunk (no transcript) unless OPENAI_TRANSCRIPTION_MODEL is pointed at a
# real speech-to-text endpoint (OpenAI's whisper-1 is the default).
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Web search enrichment (compiler/web_search.py) ---
# Off by default. --web-search / WIKI_WEB_SEARCH_ENABLED=true opts in, per
# run (Dashboard "Run options") or as a persisted default (Pipeline
# Architecture page) — see documentation/37-web-search-enrichment.md.
# WIKI_WEB_SEARCH_ENABLED=true
# WIKI_WEB_SEARCH_PROVIDER=duckduckgo   # duckduckgo (no key) | serpapi | bing
# WIKI_WEB_SEARCH_API_KEY=              # only needed for serpapi/bing

# --- External connectors (Gmail, Google Drive, IMAP) ---
# Wired into the dashboard at /connectors — see
# documentation/34-external-connectors.md. Set these to actually connect
# an account; without them the Gmail/Drive cards just show as
# "not configured" and IMAP still works (it needs no env vars at all).

# Encrypts connector credentials at rest (Fernet). Generate one with:
#   python -c "from connectors.credential_store import generate_secret_key; print(generate_secret_key())"
# CONNECTOR_SECRET_KEY=

# Google Cloud OAuth client for Gmail (gmail.readonly scope only).
# GMAIL_REDIRECT_URI must exactly match what's registered on the OAuth
# client, e.g. https://<host>/connectors/callback/gmail
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=

# Google Cloud OAuth client for Drive (drive.readonly scope only) —
# can reuse the same OAuth client as Gmail if scopes are combined there.
# GDRIVE_REDIRECT_URI, e.g. https://<host>/connectors/callback/google_drive
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REDIRECT_URI=

# IMAP connectors are configured per-account at connect time (host, port,
# mailbox, app password) rather than via env vars — there's no single
# "the" IMAP account.

# Postgres connectors are configured per-account at connect time too (host,
# port, dbname, user, schema, password), via the /database page or
# /connectors — no env vars needed to use the feature against your own
# database.

# --- Sample PostgreSQL database (docker-compose.yml's `postgres` service) ---
# Only used to seed/configure the OPTIONAL sample database container — see
# documentation/39-postgres-database-connector.md and
# docker/postgres/init.sql. Not required for the Postgres connector itself,
# which works against any reachable Postgres server. Defaults match what
# the /database page's "Fill the form with the sample database's values"
# button fills in, so change these together if you change them at all.
# POSTGRES_DB=aurora_kb
# POSTGRES_USER=wiki_reader
# POSTGRES_PASSWORD=aurora_sample_pw
# POSTGRES_PORT=5432

# --- Bootstrap admin account (backend/src/lib/users.ts) ---
# Created once on first boot, no-op afterward. Defaults to a known login
# (admin / aurora_admin, shown on the sign-in page) so a fresh install
# always has a working login instead of a random password only visible in
# `docker compose logs backend`. Override both before exposing this beyond
# local/sample use.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=aurora_admin

# --- Compiler build pipeline (compiler/server.py, /api/build/stream) ---
# Max seconds a single compiler run may take before it's killed and reported
# as a failed/timed-out build (prevents a hung LLM call or subprocess from
# holding the build lock forever). Default: 1800 (30 min).
# COMPILER_BUILD_TIMEOUT_SECONDS=1800
