# LLM for compiler (extraction, synthesis, linking, image captioning). Use OpenAI or Gemini.
# Image files under data/raw/ are captioned via a vision-capable chat completion —
# both defaults below (gpt-4o-mini, gemini-2.5-flash) support this; if you swap to
# a text-only model, image ingestion will fail (text/email/file sources are unaffected).

# --- OpenAI (default) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (OpenAI-compatible) ---
# Get a key: https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
