# LLM for compiler (extraction, synthesis, linking, image captioning). Use OpenAI or Gemini.
# Image files under data/raw/ are captioned via a vision-capable chat completion —
# both defaults below (gpt-4o-mini, gemini-2.5-flash) support this; if you swap to
# a text-only model, image ingestion will fail (text/email/file sources are unaffected).

# --- OpenAI (default) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (OpenAI-compatible) ---
# Get a key: https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# --- Local LLM: Gemma, run in-process by llama.cpp inside its own
# container (no Ollama, no separate model-management daemon) ---
# docker compose --profile local-llm up   (see docker-compose.yml + the
# `local-llm` service, docker/local-llm/, and
# documentation/33-docker-and-local-llm.md)
# The API key can be any non-empty string — llama.cpp's server doesn't
# check it, but the OpenAI SDK requires one to be set.
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://local-llm:8080/v1
# OPENAI_MODEL=gemma-4          # must match MODEL_ALIAS below

# Which GGUF file the local-llm container downloads from Hugging Face on
# first start (see docker/local-llm/entrypoint.sh) — MODEL_REPO/MODEL_FILE
# below are a placeholder naming pattern, NOT a verified Hugging Face repo;
# confirm the real repo/filename for the Gemma build you want and set
# these to match before running --profile local-llm.
# LOCAL_LLM_MODEL_REPO=google/gemma-4-it-GGUF
# LOCAL_LLM_MODEL_FILE=gemma-4-it-Q4_K_M.gguf
# LOCAL_LLM_MODEL_ALIAS=gemma-4
# HF_TOKEN=                     # only needed if MODEL_REPO is a gated Hugging Face repo

# This local-llm container serves chat completions only (extraction/
# synthesis/chat) — it does not currently serve embeddings, so
# hybrid_retrieval.py's embedding tier (task #5) and the vector-store
# wiring (task #11) still need OPENAI_EMBEDDING_MODEL pointed at OpenAI or
# Gemini's embeddings endpoint even when using the local LLM for chat.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Web search enrichment (compiler/web_search.py) ---
# Off by default. --web-search / WIKI_WEB_SEARCH_ENABLED=true opts in, per
# run (Dashboard "Run options") or as a persisted default (Pipeline
# Architecture page) — see documentation/35-web-search-enrichment.md.
# WIKI_WEB_SEARCH_ENABLED=true
# WIKI_WEB_SEARCH_PROVIDER=duckduckgo   # duckduckgo (no key) | serpapi | bing
# WIKI_WEB_SEARCH_API_KEY=              # only needed for serpapi/bing

# --- External connectors (Gmail, Google Drive, IMAP) ---
# Not wired into server.py/the dashboard yet — see
# documentation/34-external-connectors.md. compiler/connectors/ is a
# tested, standalone module; these vars are for when it gets wired up.

# Encrypts connector credentials at rest (Fernet). Generate one with:
#   python -c "from connectors.credential_store import generate_secret_key; print(generate_secret_key())"
# CONNECTOR_SECRET_KEY=

# Google Cloud OAuth client for Gmail (gmail.readonly scope only)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=

# Google Cloud OAuth client for Drive (drive.readonly scope only) —
# can reuse the same OAuth client as Gmail if scopes are combined there
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REDIRECT_URI=

# IMAP connectors are configured per-account at connect time (host, port,
# mailbox, app password) rather than via env vars — there's no single
# "the" IMAP account.
