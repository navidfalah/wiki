{
  "name": "wiki-backend",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript and TypeScript API server and compiler for the Wissensbau wiki.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fflate": "^0.8.2",
    "imapflow": "^2.10.0",
    "mailparser": "^3.9.0",
    "multer": "^2.3.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "sql.js": "^1.15.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
