{
  "name": "wiki-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + TypeScript + Tailwind server-rendered frontend for the LLM Wiki -- renders the compiled wiki pages and the dashboard as one app with one nav, calling the Express+TS backend's REST API.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build:css": "tailwindcss -i src/public/css/input.css -o dist-static/css/app.css --minify",
    "build:client": "esbuild src/client/*.ts --bundle --outdir=dist-static/js --format=iife --minify",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:fonts && npm run build:css && npm run build:client && npm run build:server",
    "dev:css": "tailwindcss -i src/public/css/input.css -o dist-static/css/app.css --watch",
    "dev:client": "esbuild src/client/*.ts --bundle --outdir=dist-static/js --sourcemap --watch",
    "dev:server": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json && npm run check:i18n",
    "lint": "eslint src test",
    "build:fonts": "mkdir -p dist-static/fonts && cp node_modules/@fontsource-variable/sora/files/sora-latin-wght-normal.woff2 node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 dist-static/fonts/",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.4.20",
    "d3-force-3d": "^3.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "force-graph": "^1.51.4",
    "happy-dom": "^20.14.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
