<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Review & Attention</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  Two lists of things worth a human look, in one place: claims trust propagation flagged as
  low-confidence or an unresolved contradiction, and wiki-health issues (unreachable pages,
  dead links, ungrounded topics, unprocessed files, reviewer findings).
</p>

<div class="mt-4 flex items-center gap-1 border-b border-gray-200">
  <button
    id="tab-btn-review"
    data-tab="review"
    class="review-attention-tab -mb-px border-b-2 border-accent px-3 py-2 text-sm font-medium text-accent">
    Review Queue
  </button>
  <button
    id="tab-btn-attention"
    data-tab="attention"
    class="review-attention-tab -mb-px border-b-2 border-transparent px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700">
    Attention
  </button>
</div>

<div id="tab-panel-review" class="review-attention-panel mt-4">
  <div id="review-stats" class="grid grid-cols-2 gap-3 sm:grid-cols-4"></div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button data-filter="all" class="review-filter rounded-full bg-gray-900 px-3 py-1.5 text-xs font-medium text-white">All</button>
    <button data-filter="low_confidence" class="review-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Low confidence</button>
    <button data-filter="unresolved_contradiction" class="review-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Unresolved contradictions</button>
    <button data-filter="unreviewed" class="review-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Needs a verdict</button>
    <button id="review-refresh" type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">↻ Refresh</button>
  </div>

  <p class="mt-3 text-xs text-gray-500">
    Scored against <code class="rounded bg-gray-100 px-1 py-0.5">data/trust_eval_dataset.json</code>, the same
    pilot dataset the trust-propagation evaluation (documentation/23) uses -- see
    documentation/29-active-learning.md for wiring this against a live compiled corpus. Your
    verdict is stored in <code class="rounded bg-gray-100 px-1 py-0.5">data/review_corrections.json</code> and
    fed back into extraction as a few-shot example on the next compile
    (<code class="rounded bg-gray-100 px-1 py-0.5">--use-corrections</code>).
  </p>

  <div id="review-empty" class="mt-4 hidden rounded-xl border border-gray-200 bg-white p-8 text-center text-sm text-gray-500"></div>
  <div id="review-list" class="mt-4 flex flex-col gap-3"></div>
</div>

<div id="tab-panel-attention" class="review-attention-panel mt-4 hidden">
  <div id="attention-cards" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"></div>

  <div class="mt-6 flex flex-wrap items-center gap-2">
    <button data-filter="all" class="attention-filter rounded-full bg-gray-900 px-3 py-1.5 text-xs font-medium text-white">All</button>
    <button data-filter="orphan_topic" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Unreachable pages</button>
    <button data-filter="dead_end_topic" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Dead ends</button>
    <button data-filter="dead_link" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Dead links</button>
    <button data-filter="ungrounded_topic" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">No source data</button>
    <button data-filter="unprocessed_file" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Unprocessed files</button>
    <button data-filter="review_finding" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Reviewer findings</button>
    <button id="attention-refresh" type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">↻ Refresh</button>
  </div>

  <p id="attention-review-note" class="mt-3 hidden text-xs text-gray-500"></p>

  <div id="attention-empty" class="mt-4 hidden rounded-xl border border-gray-200 bg-white p-8 text-center text-sm text-gray-500"></div>
  <div id="attention-list" class="mt-4 flex flex-col gap-2"></div>
</div>

<%- include('partials/foot', { clientScript }) %>
