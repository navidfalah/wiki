<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('review-queue.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%= t('review-queue.intro') %>
</p>

<div id="tab-panel-attention" class="mt-4">
  <div id="attention-cards" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"></div>

  <div class="mt-6 flex flex-wrap items-center gap-2">
    <button data-filter="all" class="attention-filter rounded-full bg-gray-900 px-3 py-1.5 text-xs font-medium text-white"><%= t('review-queue.filter.all') %></button>
    <button data-filter="orphan_topic" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('review-queue.att.unreachable') %></button>
    <button data-filter="dead_end_topic" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('review-queue.att.deadEnds') %></button>
    <button data-filter="dead_link" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('review-queue.att.deadLinks') %></button>
    <button data-filter="ungrounded_topic" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('review-queue.att.ungrounded') %></button>
    <button data-filter="unprocessed_file" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('review-queue.att.unprocessed') %></button>
    <button data-filter="review_finding" class="attention-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('review-queue.att.reviewer') %></button>
    <button id="attention-refresh" type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('review-queue.refresh') %></button>
  </div>

  <p id="attention-review-note" class="mt-3 hidden text-xs text-gray-500"></p>

  <div id="attention-empty" class="mt-4 hidden rounded-xl border border-gray-200 bg-white p-8 text-center text-sm text-gray-500"></div>
  <div id="attention-list" class="mt-4 flex flex-col gap-2"></div>
</div>

<%- include('partials/foot', { clientScript }) %>
