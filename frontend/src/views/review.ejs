<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Review Queue</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  Claims trust propagation flagged as worth a human's five seconds -- low-confidence
  scores or contradictions neither side has clearly won. Confirm, correct, or mark them
  scope-dependent; your call is stored and can be fed back into extraction as a
  few-shot example on the next compile (<code class="rounded bg-gray-100 px-1 py-0.5">--use-corrections</code>).
</p>

<div id="review-cards" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>

<div class="mt-6 flex flex-wrap items-center gap-2">
  <button data-filter="all" class="review-filter rounded-full bg-gray-900 px-3 py-1.5 text-xs font-medium text-white">All</button>
  <button data-filter="pending" class="review-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Pending</button>
  <button data-filter="reviewed" class="review-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Reviewed</button>
  <button data-filter="low_confidence" class="review-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Low confidence</button>
  <button data-filter="unresolved_contradiction" class="review-filter rounded-full border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">Contradictions</button>
  <button id="review-refresh" type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">↻ Refresh</button>
</div>

<div id="review-empty" class="mt-4 hidden rounded-xl border border-gray-200 bg-white p-8 text-center text-sm text-gray-500"></div>

<div id="review-list" class="mt-4 flex flex-col gap-3"></div>

<%- include('partials/foot', { clientScript }) %>
