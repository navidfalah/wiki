<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('rag-architecture.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%- t('rag-architecture.introHtml') %>
</p>

<section class="mt-6 rounded-xl border border-gray-200 bg-white shadow-card">
  <div class="border-b border-gray-100 px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900"><%= t('rag-architecture.presets') %></h2>
    <p class="mt-0.5 text-xs text-gray-500"><%= t('rag-architecture.presetsHint') %></p>
  </div>
  <div class="flex flex-wrap items-center gap-2 p-5">
    <select id="rag-preset-select" class="min-w-[10rem] flex-1 rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20">
      <option value=""><%= t('rag-architecture.presetNone') %></option>
    </select>
    <button id="rag-preset-load-btn" type="button" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50" disabled><%= t('rag-architecture.load') %></button>
    <button id="rag-preset-delete-btn" type="button" class="rounded-lg border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50" disabled><%= t('rag-architecture.delete') %></button>
    <span class="mx-1 h-6 w-px bg-gray-200"></span>
    <input id="rag-preset-name-input" type="text" placeholder="<%= t('rag-architecture.presetNamePh') %>" class="min-w-[10rem] flex-1 rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
    <button id="rag-preset-save-btn" type="button" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent-dark"><%= t('rag-architecture.saveAsPreset') %></button>
  </div>
  <p id="rag-preset-hint" class="px-5 pb-4 text-xs text-gray-400"></p>
</section>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900"><%= t('rag-architecture.architecture') %></h2>
      <p class="mt-0.5 text-xs text-gray-500"><%= t('rag-architecture.architectureHint') %></p>
    </div>

    <div id="architecture-options" class="flex flex-col divide-y divide-gray-100">
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="architecture" value="hybrid" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.arch.hybrid') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.arch.hybridHint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="architecture" value="naive" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.arch.naive') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.arch.naiveHint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="architecture" value="hyde" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.arch.hyde') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.arch.hydeHint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="architecture" value="fusion" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.arch.fusion') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.arch.fusionHint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="architecture" value="graph" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.arch.graph') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.arch.graphHint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="architecture" value="corrective" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.arch.corrective') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.arch.correctiveHint') %></span>
        </span>
      </label>
    </div>
  </section>

  <section id="retrieval-mode-section" class="rounded-xl border border-gray-200 bg-white shadow-card transition-opacity">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900"><%= t('rag-architecture.strategy') %></h2>
      <p class="mt-0.5 text-xs text-gray-500"><%= t('rag-architecture.strategyHint') %></p>
    </div>

    <div id="retrieval-mode-options" class="flex flex-col divide-y divide-gray-100">
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="retrieval_mode" value="bm25" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.mode.bm25') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.mode.bm25Hint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="retrieval_mode" value="hybrid" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.mode.hybrid') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.mode.hybridHint') %></span>
        </span>
      </label>
      <label class="flex items-start gap-3 px-5 py-4">
        <input type="radio" name="retrieval_mode" value="hybrid_rerank" class="mt-1 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.mode.rerank') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.mode.rerankHint') %></span>
        </span>
      </label>
    </div>

    <div class="border-t border-gray-100 px-5 py-4">
      <h3 class="text-sm font-semibold text-gray-900"><%= t('rag-architecture.answerMode') %></h3>
      <div class="mt-3 flex flex-col gap-3">
        <label class="flex items-start gap-3">
          <input type="radio" name="answer_mode" value="auto" class="mt-1 text-accent focus:ring-accent/30" />
          <span>
            <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.answer.auto') %></span>
            <span class="block text-xs text-gray-500"><%= t('rag-architecture.answer.autoHint') %></span>
          </span>
        </label>
        <label class="flex items-start gap-3">
          <input type="radio" name="answer_mode" value="extractive" class="mt-1 text-accent focus:ring-accent/30" />
          <span>
            <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.answer.extractive') %></span>
            <span class="block text-xs text-gray-500"><%= t('rag-architecture.answer.extractiveHint') %></span>
          </span>
        </label>
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-gray-100 px-5 py-4">
      <p id="rag-arch-saved-hint" class="text-xs text-gray-400"></p>
      <button id="save-rag-arch-btn" type="button" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-dark">
        <%= t('common.save') %>
      </button>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900"><%= t('rag-architecture.tuning') %></h2>
      <p class="mt-0.5 text-xs text-gray-500"><%= t('rag-architecture.tuningHint') %></p>
    </div>

    <div class="flex flex-col gap-4 p-5">
      <label class="flex flex-col gap-1 max-w-xs">
        <span class="text-xs font-medium text-gray-600"><%= t('rag-architecture.topK') %></span>
        <input data-field="top_k" type="number" min="1" step="1" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
      </label>

      <div class="grid grid-cols-2 gap-4">
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600">BM25 k1</span>
          <input data-field="bm25_k1" type="number" min="0" step="0.1" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600">BM25 b</span>
          <input data-field="bm25_b" type="number" min="0" max="1" step="0.05" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
      </div>

      <label class="flex items-start gap-3 border-t border-gray-100 pt-4">
        <input data-field="use_vector_store" type="checkbox" class="mt-0.5 rounded border-gray-300 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('rag-architecture.vectorStore') %></span>
          <span class="block text-xs text-gray-500"><%= t('rag-architecture.vectorStoreHint') %></span>
        </span>
      </label>
      <p id="vector-store-hint" class="hidden text-xs text-amber-600"><%= t('rag-architecture.vectorStoreWarn') %></p>
    </div>
  </section>
</div>

<%- include('partials/foot', { clientScript }) %>
