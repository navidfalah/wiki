<%- include('partials/head', { title, apiBase, active }) %>
<h1 class="text-2xl font-semibold text-gray-900"><%= t('rag-architecture.title') %></h1>
<p class="mt-2 max-w-2xl text-sm text-gray-600"><%= t('rag-architecture.simpleIntro') %></p>
<section class="mt-6 max-w-2xl rounded-xl border border-gray-200 bg-white p-5">
  <div class="flex flex-col gap-4">
    <% for (const mode of ['bm25', 'hybrid']) { %>
      <label class="flex items-start gap-3">
        <input type="radio" name="retrieval_mode" value="<%= mode %>" class="mt-1" />
        <span><span class="block text-sm font-medium"><%= t(mode === 'bm25' ? 'rag-architecture.mode.bm25' : 'rag-architecture.mode.hybrid') %></span>
        <span class="block text-xs text-gray-500"><%= t(mode === 'bm25' ? 'rag-architecture.mode.bm25Hint' : 'rag-architecture.mode.hybridHint') %></span></span>
      </label>
    <% } %>
    <label class="flex flex-col gap-1 text-sm"><%= t('rag-architecture.topK') %>
      <input id="results-count" type="number" min="1" max="50" class="rounded border border-gray-300 p-2" />
    </label>
    <p id="rag-arch-saved-hint" role="status" class="text-xs text-gray-500"></p>
    <button id="save-rag-arch-btn" type="button" class="rounded bg-accent px-4 py-2 text-white"><%= t('common.save') %></button>
  </div>
</section>
<%- include('partials/foot', { clientScript }) %>
