<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('company.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%= t('company.intro') %>
</p>

<div class="mt-6 max-w-3xl">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900"><%= t('company.general') %></h2>
      <p class="mt-0.5 text-xs text-gray-500"><%= t('company.optional') %></p>
    </div>

    <div id="company-form" class="flex flex-col gap-4 p-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600"><%= t('company.f.name') %></span>
          <input data-field="company_name" type="text" placeholder="<%= t('company.f.namePh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600"><%= t('company.f.industry') %></span>
          <input data-field="industry" type="text" placeholder="<%= t('company.f.industryPh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600"><%= t('company.f.website') %></span>
          <input data-field="website" type="text" placeholder="<%= t('company.f.websitePh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600"><%= t('company.f.size') %></span>
          <input data-field="size" type="text" placeholder="<%= t('company.f.sizePh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
        <label class="flex flex-col gap-1 sm:col-span-2">
          <span class="text-xs font-medium text-gray-600"><%= t('company.f.location') %></span>
          <input data-field="location" type="text" placeholder="<%= t('company.f.locationPh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
      </div>

      <label class="flex flex-col gap-1">
        <span class="text-xs font-medium text-gray-600"><%= t('company.f.description') %></span>
        <textarea data-field="description" rows="4" placeholder="<%= t('company.f.descriptionPh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"></textarea>
      </label>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600"><%= t('company.f.tone') %></span>
          <input data-field="tone_of_voice" type="text" placeholder="<%= t('company.f.tonePh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-600"><%= t('company.f.audience') %></span>
          <input data-field="target_audience" type="text" placeholder="<%= t('company.f.audiencePh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        </label>
      </div>

      <label class="flex flex-col gap-1">
        <span class="text-xs font-medium text-gray-600"><%= t('company.f.notes') %></span>
        <textarea data-field="additional_notes" rows="3" placeholder="<%= t('company.f.notesPh') %>" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"></textarea>
      </label>
    </div>

    <div class="flex items-center justify-between border-t border-gray-100 px-5 py-4">
      <p id="company-saved-hint" class="text-xs text-gray-400"></p>
      <button id="save-company-btn" type="button" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-dark">
        <%= t('common.save') %>
      </button>
    </div>
  </section>
</div>

<%- include('partials/foot', { clientScript }) %>
