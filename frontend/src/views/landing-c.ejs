<%
  const svg = (inner, size) => `<svg viewBox="0 0 24 24" width="${size || 22}" height="${size || 22}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
  const icons = {
    files: svg('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>'),
    wiki: svg('<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>'),
    chat: svg('<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/>'),
    graph: svg('<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="8" r="2.5"/><circle cx="12" cy="18" r="2.5"/><line x1="8" y1="7" x2="16" y2="7.6"/><line x1="7" y1="8.2" x2="11" y2="15.6"/><line x1="17" y1="10.3" x2="13" y2="15.7"/>'),
    plug: svg('<path d="M9 2v6"/><path d="M15 2v6"/><path d="M6 8h12v4a6 6 0 0 1-12 0z"/><path d="M12 18v4"/>'),
    shield: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'),
  };
  const arrow = svg('<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>', 18);
  const loginHref = signedIn ? '/dashboard' : '/login';
  const loginLabel = signedIn ? t.nav.dashboard : t.nav.login;
  const serif = 'font-sans';
%><!doctype html>
<html lang="<%= t.htmlLang %>" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= t.metaTitle %></title>
  <meta name="description" content="<%= t.metaDescription %>" />
  <link rel="canonical" href="<%= canonical %>" />
  <link rel="alternate" hreflang="de" href="<%= siteUrl %>/" />
  <link rel="alternate" hreflang="en" href="<%= siteUrl %>/en" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Wissensbau" />
  <meta property="og:title" content="<%= t.metaTitle %>" />
  <meta property="og:description" content="<%= t.metaDescription %>" />
  <meta property="og:url" content="<%= canonical %>" />
  <meta name="theme-color" content="#faf6ef" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <%- include('partials/fonts') %>
  <link rel="stylesheet" href="/css/app.css?v=<%= assetV %>" />
</head>
<body class="bg-[#faf6ef] font-sans text-stone-700 antialiased selection:bg-amber-200">

  <header class="mx-auto flex max-w-6xl items-center justify-between px-5 py-6">
    <a href="<%= lang === 'de' ? '/' : '/en' %>?design=c" class="flex items-center gap-2.5 no-underline">
      <!-- brick mark -->
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><g fill="#b45309"><rect x="3" y="18" width="12" height="7" rx="1"/><rect x="17" y="18" width="12" height="7" rx="1"/><rect x="10" y="8" width="12" height="8" rx="1" fill="#d97706"/></g></svg>
      <span class="<%= serif %> text-xl font-bold tracking-tight text-stone-900">Wissensbau</span>
    </a>
    <nav class="hidden items-center gap-8 text-sm text-stone-600 md:flex" aria-label="Main">
      <a href="#funktionen" class="no-underline hover:text-stone-900"><%= t.nav.features %></a>
      <a href="#ablauf" class="no-underline hover:text-stone-900"><%= t.nav.how %></a>
      <a href="#betrieb" class="no-underline hover:text-stone-900"><%= t.nav.ops %></a>
    </nav>
    <div class="flex items-center gap-3">
      <a href="/lang/<%= lang === 'de' ? 'en' : 'de' %>?next=<%= encodeURIComponent(t.nav.switchHref + '?design=c') %>" class="text-xs font-semibold text-stone-500 no-underline hover:text-stone-900"><%= t.nav.switchLabel %></a>
      <a href="<%= loginHref %>" class="rounded-full border border-stone-900 px-4 py-2 text-sm font-medium text-stone-900 no-underline transition hover:bg-stone-900 hover:text-[#faf6ef]"><%= loginLabel %></a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-5 pb-20 pt-10 md:pt-20">
      <div class="grid items-end gap-12 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700 animate-rise"><%= t.hero.badge %></p>
          <h1 class="<%= serif %> mt-5 text-5xl font-bold leading-[1.02] tracking-tight text-stone-900 sm:text-6xl lg:text-7xl animate-rise">
            <%= t.hero.titleLead %>
            <em class="not-italic text-amber-700"><%= t.hero.titleAccent %></em>
          </h1>
        </div>
        <div class="animate-rise">
          <p class="text-lg leading-relaxed text-stone-600"><%= t.hero.text %></p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="<%= loginHref %>" class="inline-flex items-center gap-2 rounded-full bg-stone-900 px-6 py-3 text-sm font-semibold text-[#faf6ef] no-underline transition hover:bg-amber-800">
              <%= signedIn ? t.nav.dashboard : t.hero.ctaPrimary %> <%- arrow %>
            </a>
            <a href="#ablauf" class="text-sm font-semibold text-stone-700 underline decoration-amber-600/50 underline-offset-4 hover:decoration-amber-700"><%= t.hero.ctaSecondary %></a>
          </div>
        </div>
      </div>

      <!-- Brick wall band: the "Bau" in Wissensbau -->
      <div class="mt-16 space-y-1.5 overflow-hidden" aria-hidden="true">
        <% [0, 1, 2].forEach(function(row) { %>
          <div class="flex gap-1.5 <%= row === 1 ? '-ml-10' : '' %>">
            <% for (let i = 0; i < 14; i++) {
                 const tones = ['bg-amber-700/90', 'bg-amber-600/80', 'bg-orange-700/80', 'bg-amber-800/90', 'bg-stone-800', 'bg-amber-500/70'];
                 const tone = tones[(i * 3 + row * 5) % tones.length]; %>
              <span class="h-6 w-20 shrink-0 rounded-[3px] <%= tone %> sm:h-8 sm:w-28"></span>
            <% } %>
          </div>
        <% }); %>
      </div>
      <p class="mt-5 text-xs tracking-wide text-stone-500"><%= t.hero.formats %></p>
    </section>

    <!-- Quote-style demo -->
    <section class="border-y border-stone-300/70 bg-white/60 py-16">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-[1fr_1.3fr] lg:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700"><%= t.mock.page %></p>
          <p class="<%= serif %> mt-4 text-2xl leading-snug text-stone-900 sm:text-3xl">„<%= t.mock.question %>“</p>
        </div>
        <div class="rounded-2xl border border-stone-300 bg-white p-6 shadow-[6px_6px_0_0_rgba(180,83,9,0.15)]" aria-hidden="true">
          <p class="text-base leading-relaxed text-stone-800"><%= t.mock.answer %></p>
          <div class="mt-4 flex flex-wrap gap-2 border-t border-stone-200 pt-4">
            <% t.mock.sources.forEach(function(source, i) { %>
              <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800 ring-1 ring-amber-200">[<%= i + 1 %>] <%= source %></span>
            <% }); %>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works: big numerals -->
    <section id="ablauf" class="scroll-mt-8 mx-auto max-w-6xl px-5 py-24">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700"><%= t.how.eyebrow %></p>
      <h2 class="<%= serif %> mt-3 max-w-2xl text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl"><%= t.how.title %></h2>
      <ol class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        <% t.how.steps.forEach(function(step, i) { %>
          <li class="border-t-2 border-stone-900 pt-5">
            <span class="<%= serif %> text-5xl font-bold text-amber-600/80"><%= i + 1 %></span>
            <h3 class="<%= serif %> mt-3 text-xl font-bold text-stone-900"><%= step.title %></h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600"><%= step.text %></p>
          </li>
        <% }); %>
      </ol>
    </section>

    <!-- Features: ruled list -->
    <section id="funktionen" class="scroll-mt-8 bg-stone-900 py-24 text-stone-300">
      <div class="mx-auto max-w-6xl px-5">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400"><%= t.features.eyebrow %></p>
        <h2 class="<%= serif %> mt-3 max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl"><%= t.features.title %></h2>
        <div class="mt-14 grid gap-x-16 md:grid-cols-2">
          <% t.features.items.forEach(function(item) { %>
            <article class="flex gap-5 border-t border-white/15 py-7">
              <span class="mt-1 shrink-0 text-amber-400"><%- icons[item.icon] %></span>
              <div>
                <h3 class="<%= serif %> text-xl font-bold text-white"><%= item.title %></h3>
                <p class="mt-2 text-sm leading-relaxed text-stone-400"><%= item.text %></p>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Operations -->
    <section id="betrieb" class="scroll-mt-8 mx-auto max-w-6xl px-5 py-24">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700"><%= t.ops.eyebrow %></p>
          <h2 class="<%= serif %> mt-3 text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl"><%= t.ops.title %></h2>
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-stone-600"><%= t.ops.text %></p>
        </div>
        <ul class="divide-y divide-stone-300 self-center border-y border-stone-300">
          <% t.ops.points.forEach(function(point) { %>
            <li class="<%= serif %> flex items-center gap-4 py-4 text-lg text-stone-900"><span class="h-2 w-2 shrink-0 rotate-45 bg-amber-600"></span><%= point %></li>
          <% }); %>
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-amber-700 px-5 py-20 text-center">
      <h2 class="<%= serif %> mx-auto max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl"><%= t.cta.title %></h2>
      <p class="mt-4 text-amber-100"><%= t.cta.text %></p>
      <a href="<%= loginHref %>" class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3 text-sm font-semibold text-stone-900 no-underline transition hover:bg-stone-900 hover:text-white">
        <%= signedIn ? t.nav.dashboard : t.cta.button %> <%- arrow %>
      </a>
    </section>
  </main>

  <footer class="bg-stone-900 text-stone-400">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-8 text-sm sm:flex-row">
      <p><span class="<%= serif %> font-bold text-white">Wissensbau</span> · wissensbau.de · <%= t.footer.tagline %> <span class="opacity-70"><%= t.footer.note %></span></p>
      <p class="flex items-center gap-4">
        <% if (imprintUrl) { %><a href="<%= imprintUrl %>" class="no-underline hover:text-white"><%= t.footer.imprint %></a><% } %>
        <% if (privacyUrl) { %><a href="<%= privacyUrl %>" class="no-underline hover:text-white"><%= t.footer.privacy %></a><% } %>
        <span>© <%= year %></span>
      </p>
    </div>
  </footer>
</body>
</html>
