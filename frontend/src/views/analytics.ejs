<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Analytics</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">Counts, broken links, and tags from the last compile.</p>

<div id="analytics-cards" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-5"></div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-3">
      <h2 class="text-sm font-semibold text-gray-900">Dead links</h2>
    </div>
    <div id="dead-links-list" class="max-h-96 overflow-auto p-4 text-sm"></div>
  </section>
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-3">
      <h2 class="text-sm font-semibold text-gray-900">Tags</h2>
    </div>
    <div id="tags-list" class="max-h-96 overflow-auto p-4 text-sm"></div>
  </section>
</div>

<%- include('partials/foot', { clientScript }) %>
