<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('logs.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%= t('logs.intro') %>
</p>

<div class="mt-4 flex flex-wrap items-center gap-2">
  <select id="logs-level-filter" class="rounded-lg border border-gray-300 bg-white px-2.5 py-1.5 text-sm text-gray-700">
    <option value=""><%= t('logs.levelAll') %></option>
    <option value="error"><%= t('common.level.error') %></option>
    <option value="warn"><%= t('common.level.warn') %></option>
    <option value="info"><%= t('common.level.info') %></option>
  </select>
  <select id="logs-category-filter" class="rounded-lg border border-gray-300 bg-white px-2.5 py-1.5 text-sm text-gray-700">
    <option value=""><%= t('logs.categoryAll') %></option>
  </select>
  <input
    id="logs-search"
    type="search"
    placeholder="<%= t('logs.searchPlaceholder') %>"
    class="min-w-[12rem] flex-1 rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm text-gray-700" />
  <label class="flex items-center gap-1.5 text-xs text-gray-600">
    <input id="logs-auto-refresh" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
    <%= t('logs.autoRefresh') %>
  </label>
  <span id="logs-status" class="text-xs text-gray-500"></span>
  <button id="logs-refresh" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50"><%= t('common.refresh') %></button>
</div>

<div class="mt-3 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-card">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-gray-100 bg-gray-50 text-xs text-gray-500">
      <tr>
        <th class="px-4 py-2.5 font-medium"><%= t('logs.th.when') %></th>
        <th class="px-4 py-2.5 font-medium"><%= t('logs.th.level') %></th>
        <th class="px-4 py-2.5 font-medium"><%= t('logs.th.category') %></th>
        <th class="px-4 py-2.5 font-medium"><%= t('logs.th.user') %></th>
        <th class="px-4 py-2.5 font-medium"><%= t('logs.th.action') %></th>
        <th class="px-4 py-2.5 font-medium"><%= t('logs.th.detail') %></th>
        <th class="px-2 py-2.5 font-medium"><span class="sr-only"><%= t('logs.th.copy') %></span></th>
      </tr>
    </thead>
    <tbody id="logs-body" class="divide-y divide-gray-100"></tbody>
  </table>
</div>

<%- include('partials/foot', { clientScript }) %>
