<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Chat</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  Ask a question and get an answer grounded in, and cited to, the compiled wiki pages it came from.
</p>

<div class="mt-6 flex flex-col gap-4">
  <div class="flex items-center justify-between gap-2">
    <div id="chat-status" class="text-xs text-gray-500"></div>
    <button id="chat-clear" type="button" class="shrink-0 rounded-lg border border-gray-300 bg-white px-2.5 py-1 text-xs font-medium text-gray-600 hover:bg-gray-50">Clear history</button>
  </div>
  <div id="chat-messages" class="flex min-h-[300px] flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-card"></div>
  <form id="chat-form" class="flex gap-2">
    <input id="chat-input" type="text" placeholder="Ask a question about the wiki…" class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
    <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-dark">Ask</button>
  </form>
</div>

<%- include('partials/foot', { clientScript }) %>
