<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Token Usage & Cost</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  Tokens and estimated spend across every recorded pipeline run, broken down by process, model, and day.
</p>

<div id="offline-banner" class="hidden mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700"></div>

<div id="usage-cards" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>

<div id="usage-note" class="mt-4"></div>

<div class="relative mt-6 grid gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-3">
      <h2 class="text-sm font-semibold text-gray-900">Daily estimated cost</h2>
    </div>
    <div id="usage-daily-cost-chart" class="p-4"></div>
  </section>
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-3">
      <h2 class="text-sm font-semibold text-gray-900">Daily tokens used</h2>
    </div>
    <div id="usage-daily-tokens-chart" class="p-4"></div>
  </section>
  <div id="usage-chart-tooltip" class="pointer-events-none absolute z-10 hidden rounded-lg bg-gray-900 px-2.5 py-1.5 text-xs text-white shadow-lg"></div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-3">
      <h2 class="text-sm font-semibold text-gray-900">By process</h2>
    </div>
    <div id="usage-by-process" class="overflow-auto p-4"></div>
  </section>
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-3">
      <h2 class="text-sm font-semibold text-gray-900">By model</h2>
    </div>
    <div id="usage-by-model" class="overflow-auto p-4"></div>
  </section>
</div>

<%- include('partials/foot', { clientScript }) %>
