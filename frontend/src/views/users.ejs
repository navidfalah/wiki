<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('users.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%= t('users.intro') %>
</p>

<div id="admin-stats" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.accounts') %></p><p data-stat="total" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.admins') %></p><p data-stat="admins" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.users') %></p><p data-stat="users" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.sessions') %></p><p data-stat="sessions" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
</div>

<section class="mt-6 rounded-xl border border-gray-200 bg-white shadow-card">
  <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900"><%= t('users.accounts') %></h2>
    <button aria-controls="add-user-form" aria-expanded="false" aria-haspopup="true" id="add-user-toggle" type="button" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent-dark"><%= t('users.add') %></button>
  </div>
  <div id="add-user-form" class="hidden border-b border-gray-100 p-5"></div>
  <div id="users-list" class="divide-y divide-gray-100">
    <p class="p-5 text-sm text-gray-500"><%= t('common.loading') %></p>
  </div>
</section>

<section class="mt-6 rounded-xl border border-gray-200 bg-white shadow-card">
  <div class="border-b border-gray-100 px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900"><%= t('users.activity') %></h2>
  </div>
  <div id="auth-events" class="divide-y divide-gray-100">
    <p class="p-5 text-sm text-gray-500"><%= t('common.loading') %></p>
  </div>
</section>

<%- include('partials/foot', { clientScript }) %>
