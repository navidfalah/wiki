<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('users.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%= t('users.intro') %>
</p>

<div id="admin-stats" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.accounts') %></p><p data-stat="total" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.admins') %></p><p data-stat="admins" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.users') %></p><p data-stat="users" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
  <div class="rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-card"><p class="text-xs text-gray-500"><%= t('users.stat.sessions') %></p><p data-stat="sessions" class="mt-1 text-2xl font-semibold text-gray-900">–</p></div>
</div>

<section class="mt-6 rounded-xl border border-gray-200 bg-white shadow-card">
  <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900"><%= t('users.accounts') %></h2>
    <button aria-controls="add-user-form" aria-expanded="false" aria-haspopup="true" id="add-user-toggle" type="button" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent-dark"><%= t('users.add') %></button>
  </div>
  <div id="add-user-form" class="hidden border-b border-gray-100 p-5"></div>
  <div id="users-list" class="divide-y divide-gray-100">
    <p class="p-5 text-sm text-gray-500"><%= t('common.loading') %></p>
  </div>
</section>

<section class="mt-6 rounded-xl border border-gray-200 bg-white shadow-card">
  <div class="border-b border-gray-100 px-5 py-4">
    <h2 class="text-base font-semibold text-gray-900"><%= t('users.activity') %></h2>
  </div>
  <div id="auth-events" class="divide-y divide-gray-100">
    <p class="p-5 text-sm text-gray-500"><%= t('common.loading') %></p>
  </div>
</section>

<section class="mt-6 rounded-xl border border-gray-200 bg-white shadow-card">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-4">
    <div class="min-w-0">
      <h2 class="text-base font-semibold text-gray-900"><%= t('users.backups.title') %></h2>
      <p class="mt-0.5 max-w-2xl text-xs text-gray-500"><%= t('users.backups.intro') %></p>
      <p id="backup-schedule" class="mt-0.5 text-xs text-gray-500"></p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <label class="cursor-pointer rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
        <%= t('users.backups.upload') %>
        <input id="backup-upload" type="file" accept=".gz,.tgz,application/gzip" class="hidden" />
      </label>
      <button id="backup-create" type="button" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent-dark"><%= t('users.backups.create') %></button>
    </div>
  </div>
  <div id="backups-list" class="divide-y divide-gray-100">
    <p class="p-5 text-sm text-gray-500"><%= t('common.loading') %></p>
  </div>
</section>

<section class="mt-6 rounded-xl border border-gray-200 bg-white shadow-card" aria-labelledby="sync-heading">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-4">
    <div class="min-w-0">
      <h2 id="sync-heading" class="text-base font-semibold text-gray-900"><%= t('users.sync.title') %></h2>
      <p class="mt-0.5 max-w-2xl text-xs text-gray-500"><%= t('users.sync.intro') %></p>
      <p id="sync-status" class="mt-0.5 text-xs text-gray-500" role="status"></p>
    </div>
    <button id="sync-run" type="button" class="shrink-0 rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent-dark"><%= t('users.sync.runNow') %></button>
  </div>
  <form id="sync-form" class="flex flex-col gap-4 border-b border-gray-100 px-5 py-4">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <label class="flex items-center gap-2 text-sm text-gray-900"><input name="enabled" type="checkbox" class="h-4 w-4 rounded border-gray-300" /><%= t('users.sync.enabled') %></label>
      <label class="flex items-center gap-2 text-sm text-gray-900"><%= t('users.sync.interval') %>
        <input name="interval_hours" type="number" min="1" max="720" step="1" value="24" class="w-20 rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-900"><input name="compile_after_sync" type="checkbox" checked class="h-4 w-4 rounded border-gray-300" /><%= t('users.sync.compile') %></label>
    </div>
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500"><%= t('users.sync.accounts') %></h3>
      <div id="sync-connections" class="mt-2 flex flex-col gap-2"><p class="text-sm text-gray-500"><%= t('common.loading') %></p></div>
    </div>
    <div><button type="submit" class="rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700"><%= t('users.sync.save') %></button></div>
  </form>
  <div class="border-b border-gray-100 px-5 pb-1 pt-3"><h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500"><%= t('users.sync.runs') %></h3></div>
  <div id="sync-runs"><p class="p-5 text-sm text-gray-500"><%= t('common.loading') %></p></div>
</section>

<%- include('partials/foot', { clientScript }) %>
