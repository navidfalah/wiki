<%- include('partials/head', { title, apiBase, active }) %>

<div class="flex items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-gray-900">Wiki</h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-600">
      Every compiled wiki page, auto-sorted into folders by topic. Switch to file mode to see them all in one layer.
    </p>
  </div>
  <span class="hidden shrink-0 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-500 sm:inline-block">
    <%= pages.length %> page<%= pages.length === 1 ? '' : 's' %>
  </span>
</div>

<div class="mt-4 flex flex-wrap items-center gap-3">
  <input
    id="wiki-search"
    type="search"
    placeholder="Search files…"
    class="w-full max-w-sm rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
  />

  <div id="wiki-mode-toggle" class="ml-auto inline-flex rounded-lg border border-gray-200 bg-gray-100 p-0.5 text-sm">
    <button type="button" data-mode="folders" class="wiki-mode-btn rounded-md px-3 py-1 font-medium transition-colors">
      📁 Folders
    </button>
    <button type="button" data-mode="files" class="wiki-mode-btn rounded-md px-3 py-1 font-medium transition-colors">
      📄 All files
    </button>
  </div>
</div>

<nav id="wiki-breadcrumb" class="mt-4 hidden items-center gap-1.5 text-sm text-gray-500">
  <button type="button" id="wiki-breadcrumb-back" class="font-medium text-accent hover:underline">Wiki</button>
  <span>/</span>
  <span id="wiki-breadcrumb-current" class="font-medium text-gray-700"></span>
</nav>

<div id="wiki-folder-grid" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
  <% folders.forEach(function(folder) { %>
    <button
      type="button"
      class="wiki-folder-tile group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200 bg-white p-4 text-center shadow-card transition-shadow hover:shadow-md"
      data-category="<%= folder.name %>"
      data-title="<%= folder.name.toLowerCase() %>">
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-xl text-accent">📁</span>
      <span class="line-clamp-2 w-28 text-xs font-medium text-gray-800"><%= folder.name %></span>
      <span class="text-[10px] font-medium tracking-wide text-gray-400">
        <%= folder.pages.length %> page<%= folder.pages.length === 1 ? '' : 's' %>
      </span>
    </button>
  <% }); %>
  <% if (folders.length === 0) { %>
    <p class="col-span-full py-10 text-center text-sm text-gray-400">No compiled pages yet. Run the compiler.</p>
  <% } %>
</div>

<div id="wiki-file-grid" class="mt-6 hidden grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
  <% pages.forEach(function(page) { %>
    <div
      class="wiki-file-tile group relative flex flex-col items-center gap-1.5 rounded-xl border border-gray-200 bg-white p-4 text-center shadow-card transition-shadow hover:shadow-md"
      data-title="<%= page.title.toLowerCase() %>"
      data-category="<%= page.category %>"
      data-slug="<%= page.slug %>">

      <div class="absolute right-2 top-2 flex gap-1 opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
        <a href="/wiki/<%= page.slug %>"
           title="View"
           aria-label="View <%= page.title %>"
           class="flex h-7 w-7 items-center justify-center rounded-md bg-white text-gray-500 no-underline shadow-sm ring-1 ring-gray-200 hover:text-accent hover:ring-accent/40">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </a>
        <a href="/wiki/<%= page.slug %>/edit"
           title="Edit"
           aria-label="Edit <%= page.title %>"
           class="flex h-7 w-7 items-center justify-center rounded-md bg-white text-gray-500 no-underline shadow-sm ring-1 ring-gray-200 hover:text-accent hover:ring-accent/40">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"></path></svg>
        </a>
        <button
          type="button"
          title="Delete"
          aria-label="Delete <%= page.title %>"
          class="wiki-delete-btn flex h-7 w-7 items-center justify-center rounded-md bg-white text-gray-500 shadow-sm ring-1 ring-gray-200 hover:text-red-600 hover:ring-red-300"
          data-slug="<%= page.slug %>"
          data-title="<%= page.title %>">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
        </button>
      </div>

      <a href="/wiki/<%= page.slug %>" class="flex flex-col items-center gap-1.5 no-underline">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-generated-bg text-xl text-generated">📄</span>
        <span class="line-clamp-2 w-28 text-xs font-medium text-gray-800"><%= page.title %></span>
        <span class="text-[10px] font-medium tracking-wide text-gray-400">TXT</span>
      </a>
    </div>
  <% }); %>
  <% if (pages.length === 0) { %>
    <p class="col-span-full py-10 text-center text-sm text-gray-400">No compiled pages yet. Run the compiler.</p>
  <% } %>
</div>

<p id="wiki-empty-state" class="col-span-full hidden py-10 text-center text-sm text-gray-400">No matching pages.</p>

<script>
  (function () {
    var STORAGE_KEY = 'wiki-view-mode';
    var folderGrid = document.getElementById('wiki-folder-grid');
    var fileGrid = document.getElementById('wiki-file-grid');
    var breadcrumb = document.getElementById('wiki-breadcrumb');
    var breadcrumbCurrent = document.getElementById('wiki-breadcrumb-current');
    var breadcrumbBack = document.getElementById('wiki-breadcrumb-back');
    var searchInput = document.getElementById('wiki-search');
    var emptyState = document.getElementById('wiki-empty-state');
    var modeButtons = document.querySelectorAll('.wiki-mode-btn');

    var mode = localStorage.getItem(STORAGE_KEY) === 'files' ? 'files' : 'folders';
    var activeFolder = null; // category name, when drilled into a folder while in "folders" mode

    function updateModeButtons() {
      modeButtons.forEach(function (btn) {
        var isActive = btn.dataset.mode === mode;
        btn.classList.toggle('bg-white', isActive);
        btn.classList.toggle('shadow-sm', isActive);
        btn.classList.toggle('text-gray-900', isActive);
        btn.classList.toggle('text-gray-500', !isActive);
      });
    }

    function applyFilter(container, selector, needle) {
      var visible = 0;
      container.querySelectorAll(selector).forEach(function (tile) {
        var matches = !needle || tile.dataset.title.indexOf(needle) !== -1;
        tile.style.display = matches ? '' : 'none';
        if (matches) visible += 1;
      });
      return visible;
    }

    function render() {
      var needle = searchInput.value.trim().toLowerCase();
      updateModeButtons();

      if (mode === 'files') {
        folderGrid.classList.add('hidden');
        fileGrid.classList.remove('hidden');
        fileGrid.classList.add('grid');
        breadcrumb.classList.add('hidden');
        fileGrid.querySelectorAll('.wiki-file-tile').forEach(function (tile) {
          tile.style.display = '';
        });
        var visible = applyFilter(fileGrid, '.wiki-file-tile', needle);
        emptyState.classList.toggle('hidden', visible !== 0 || fileGrid.children.length === 0);
        return;
      }

      // folders mode
      if (activeFolder) {
        folderGrid.classList.add('hidden');
        fileGrid.classList.remove('hidden');
        fileGrid.classList.add('grid');
        breadcrumb.classList.remove('hidden');
        breadcrumbCurrent.textContent = activeFolder;
        var visibleInFolder = 0;
        fileGrid.querySelectorAll('.wiki-file-tile').forEach(function (tile) {
          var matches = tile.dataset.category === activeFolder && (!needle || tile.dataset.title.indexOf(needle) !== -1);
          tile.style.display = matches ? '' : 'none';
          if (matches) visibleInFolder += 1;
        });
        emptyState.classList.toggle('hidden', visibleInFolder !== 0);
      } else {
        folderGrid.classList.remove('hidden');
        folderGrid.classList.add('grid');
        fileGrid.classList.add('hidden');
        breadcrumb.classList.add('hidden');
        var visibleFolders = applyFilter(folderGrid, '.wiki-folder-tile', needle);
        emptyState.classList.toggle('hidden', visibleFolders !== 0 || folderGrid.children.length === 0);
      }
    }

    modeButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        mode = btn.dataset.mode;
        activeFolder = null;
        localStorage.setItem(STORAGE_KEY, mode);
        searchInput.value = '';
        render();
      });
    });

    document.querySelectorAll('.wiki-folder-tile').forEach(function (tile) {
      tile.addEventListener('click', function () {
        activeFolder = tile.dataset.category;
        searchInput.value = '';
        render();
      });
    });

    breadcrumbBack.addEventListener('click', function () {
      activeFolder = null;
      render();
    });

    searchInput.addEventListener('input', render);

    render();
  })();

  var apiBase = document.querySelector('meta[name="api-base"]')?.getAttribute('content') ?? '';

  document.querySelectorAll('.wiki-delete-btn').forEach(function (btn) {
    btn.addEventListener('click', async function (event) {
      event.preventDefault();
      event.stopPropagation();
      var slug = btn.dataset.slug;
      var title = btn.dataset.title;
      if (!confirm('Delete "' + title + '"? This cannot be undone.')) return;
      btn.disabled = true;
      try {
        var res = await fetch(apiBase + '/api/docs/' + slug + '.md', { method: 'DELETE' });
        if (!res.ok) throw new Error('Delete failed (' + res.status + ')');
        var tile = btn.closest('.wiki-file-tile');
        if (tile) tile.remove();
        window.showToast('Deleted "' + title + '"', 'success');
      } catch (err) {
        window.showToast(err.message || 'Failed to delete page.', 'error');
        btn.disabled = false;
      }
    });
  });
</script>

<%- include('partials/foot', { clientScript: null }) %>
