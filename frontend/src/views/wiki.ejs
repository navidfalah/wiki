<%- include('partials/head', { title: doc.title, apiBase, active: 'Wiki' }) %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[240px_1fr_200px]">
  <aside class="order-2 lg:order-1">
    <div class="sticky top-20">
      <input
        id="wiki-search"
        type="search"
        placeholder="Search pages…"
        class="mb-3 w-full rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
      />
      <nav id="wiki-page-list" class="max-h-[75vh] space-y-0.5 overflow-y-auto text-sm">
        <% pages.forEach(function(page) { %>
          <a
            href="/wiki/<%= page.slug %>"
            data-title="<%= page.title.toLowerCase() %>"
            class="block truncate rounded-md px-2 py-1 no-underline <%= page.slug === currentSlug ? 'bg-generated-bg font-medium text-generated' : 'text-gray-600 hover:bg-gray-100' %>">
            <%= page.title %>
          </a>
        <% }); %>
      </nav>
    </div>
  </aside>

  <article class="order-1 min-w-0 lg:order-2">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-card sm:p-8">
      <div class="prose prose-slate max-w-none prose-headings:scroll-mt-24 prose-a:text-generated prose-a:no-underline hover:prose-a:underline">
        <%- doc.html %>
      </div>
    </div>
  </article>

  <% if (doc.headings.length > 0) { %>
    <aside class="order-3 hidden lg:block">
      <div class="sticky top-20">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">On this page</p>
        <nav class="space-y-1 text-sm">
          <% doc.headings.forEach(function(h) { %>
            <a href="#<%= h.id %>" class="block truncate text-gray-500 no-underline hover:text-gray-900 <%= h.level === 3 ? 'pl-3' : '' %>">
              <%= h.text %>
            </a>
          <% }); %>
        </nav>
      </div>
    </aside>
  <% } %>
</div>

<script>
  document.getElementById('wiki-search').addEventListener('input', function (event) {
    var needle = event.target.value.trim().toLowerCase();
    document.querySelectorAll('#wiki-page-list a').forEach(function (link) {
      link.style.display = !needle || link.dataset.title.includes(needle) ? '' : 'none';
    });
  });
</script>

<%- include('partials/foot', { clientScript: null }) %>
