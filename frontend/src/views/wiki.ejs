<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Wiki</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  Every compiled wiki page, as a file. Click one to download it as <code>.txt</code> —
  nothing is shown inline.
</p>

<input
  id="wiki-search"
  type="search"
  placeholder="Search files…"
  class="mt-4 w-full max-w-sm rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
/>

<div id="wiki-file-grid" class="mt-6 grid grid-cols-3 gap-1 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
  <% pages.forEach(function(page) { %>
    <a
      href="/wiki/<%= page.slug %>/download"
      data-title="<%= page.title.toLowerCase() %>"
      class="wiki-file-tile flex flex-col items-center gap-1.5 rounded-lg p-3 text-center no-underline hover:bg-gray-50">
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-generated-bg text-xl text-generated">📄</span>
      <span class="line-clamp-2 w-24 text-xs font-medium text-gray-800"><%= page.title %></span>
      <span class="text-[10px] font-medium tracking-wide text-gray-400">TXT</span>
    </a>
  <% }); %>
  <% if (pages.length === 0) { %>
    <p class="col-span-full py-10 text-center text-sm text-gray-400">No compiled pages yet. Run the compiler.</p>
  <% } %>
</div>

<script>
  document.getElementById('wiki-search').addEventListener('input', function (event) {
    var needle = event.target.value.trim().toLowerCase();
    document.querySelectorAll('.wiki-file-tile').forEach(function (tile) {
      tile.style.display = !needle || tile.dataset.title.includes(needle) ? '' : 'none';
    });
  });
</script>

<%- include('partials/foot', { clientScript: null }) %>
