<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · Aurora Labs Wiki</title>
  <meta name="api-base" content="<%= apiBase %>" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="app-shell min-h-screen text-gray-900">
  <div class="flex min-h-screen flex-col md:flex-row">
    <%
      const svg = (inner) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
      const icons = {
        wiki: svg('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line>'),
        dashboard: svg('<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>'),
        pipelines: svg('<line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path>'),
        chat: svg('<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>'),
        mail: svg('<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>'),
        link: svg('<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>'),
        graph: svg('<circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>'),
        analytics: svg('<line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line>'),
        architecture: svg('<line x1="4" y1="6" x2="20" y2="6"></line><circle cx="9" cy="6" r="2"></circle><line x1="4" y1="12" x2="20" y2="12"></line><circle cx="15" cy="12" r="2"></circle><line x1="4" y1="18" x2="20" y2="18"></line><circle cx="11" cy="18" r="2"></circle>'),
        rag: svg('<ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path><path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"></path>'),
        attention: svg('<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line>'),
        review: svg('<path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>'),
        connectors: svg('<rect x="2" y="7" width="7" height="10" rx="1"></rect><rect x="15" y="7" width="7" height="10" rx="1"></rect><line x1="9" y1="12" x2="15" y2="12"></line>'),
        entities: svg('<circle cx="12" cy="7" r="3"></circle><path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path>'),
        settings: svg('<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>'),
        logs: svg('<path d="M8 6h13"></path><path d="M8 12h13"></path><path d="M8 18h13"></path><path d="M3 6h.01"></path><path d="M3 12h.01"></path><path d="M3 18h.01"></path>'),
        users: svg('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>'),
        company: svg('<path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 21v-6h6v6"></path><path d="M9 10h.01"></path><path d="M15 10h.01"></path><path d="M9 14h.01"></path><path d="M15 14h.01"></path>'),
      };
      const links = [
        {href: '/dashboard', label: 'Dashboard', icon: icons.dashboard},
        {href: '/resources', label: 'Resources', icon: icons.link},
        {href: '/wiki', label: 'Wiki', icon: icons.wiki},
        {href: '/pipelines', label: 'Pipelines', icon: icons.pipelines},
        {href: '/pipeline-architecture', label: 'Pipeline Architecture', icon: icons.architecture},
        {href: '/chat', label: 'Chat', icon: icons.chat},
        {href: '/rag-architecture', label: 'RAG Architecture', icon: icons.rag},
        {href: '/emails', label: 'Emails', icon: icons.mail},
        {href: '/graph', label: 'Graph', icon: icons.graph},
        {href: '/entities', label: 'Entities', icon: icons.entities},
        {href: '/analytics', label: 'Analytics', icon: icons.analytics},
        {href: '/attention', label: 'Attention', icon: icons.attention},
        {href: '/review-queue', label: 'Review Queue', icon: icons.review},
        {href: '/review', label: 'Review', icon: icons.review},
        {href: '/connectors', label: 'Connectors', icon: icons.connectors},
        {href: '/logs', label: 'Logs', icon: icons.logs},
        {href: '/company', label: 'Company', icon: icons.company},
        {href: '/settings', label: 'Settings', icon: icons.settings},
        ...(typeof currentUser !== 'undefined' && currentUser?.role === 'admin' ? [{href: '/users', label: 'Users', icon: icons.users}] : []),
      ];
    %>

    <aside class="shrink-0 border-b border-gray-200 bg-white md:sticky md:top-0 md:h-screen md:w-56 md:border-b-0 md:border-r">
      <div class="flex items-center gap-2 border-b border-gray-100 px-4 py-4">
        <a href="/dashboard" class="truncate text-base font-semibold tracking-tight text-gray-900 no-underline">
          Aurora Labs Wiki
        </a>
      </div>
      <nav
        class="flex gap-1 overflow-x-auto px-2 py-2 text-sm md:flex-col md:gap-0.5 md:overflow-visible md:px-3 md:py-3"
        aria-label="Main">
        <% links.forEach(function(link) { %>
          <a href="<%= link.href %>"
             class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 font-medium no-underline transition-colors <%= active === link.label ? 'bg-generated-bg text-generated' : 'text-gray-600 hover:bg-gray-100' %>">
            <span aria-hidden="true" class="flex h-[18px] w-[18px] shrink-0 items-center justify-center"><%- link.icon %></span>
            <span><%= link.label %></span>
          </a>
        <% }); %>
      </nav>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="flex items-center justify-between gap-2 border-t border-gray-100 px-4 py-3 text-xs text-gray-500">
          <span class="truncate" title="<%= currentUser.username %> (<%= currentUser.role %>)"><%= currentUser.username %></span>
          <form method="POST" action="/logout">
            <button type="submit" class="font-medium text-gray-500 hover:text-gray-900">Log out</button>
          </form>
        </div>
      <% } %>
    </aside>

    <div class="min-w-0 flex-1">
      <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
