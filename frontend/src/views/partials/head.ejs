<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · Aurora Labs Wiki</title>
  <meta name="api-base" content="<%= apiBase %>" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="app-shell min-h-screen text-gray-900">
  <div class="flex min-h-screen flex-col md:flex-row">
    <% const links = [
      {href: '/wiki', label: 'Wiki', icon: '📄'},
      {href: '/dashboard', label: 'Dashboard', icon: '🏠'},
      {href: '/chat', label: 'Chat', icon: '💬'},
      {href: '/emails', label: 'Emails', icon: '✉️'},
      {href: '/resources', label: 'Resources', icon: '🔗'},
      {href: '/graph', label: 'Graph', icon: '🕸️'},
      {href: '/analytics', label: 'Analytics', icon: '📊'},
    ]; %>

    <aside class="shrink-0 border-b border-gray-200 bg-white md:sticky md:top-0 md:h-screen md:w-56 md:border-b-0 md:border-r">
      <div class="flex items-center gap-2 border-b border-gray-100 px-4 py-4">
        <a href="/wiki" class="truncate text-base font-semibold tracking-tight text-gray-900 no-underline">
          Aurora Labs Wiki
        </a>
      </div>
      <nav
        class="flex gap-1 overflow-x-auto px-2 py-2 text-sm md:flex-col md:gap-0.5 md:overflow-visible md:px-3 md:py-3"
        aria-label="Main">
        <% links.forEach(function(link) { %>
          <a href="<%= link.href %>"
             class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 font-medium no-underline transition-colors <%= active === link.label ? 'bg-generated-bg text-generated' : 'text-gray-600 hover:bg-gray-100' %>">
            <span aria-hidden="true"><%= link.icon %></span>
            <span><%= link.label %></span>
          </a>
        <% }); %>
      </nav>
    </aside>

    <div class="min-w-0 flex-1">
      <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
