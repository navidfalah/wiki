<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · Aurora Labs Wiki</title>
  <meta name="api-base" content="<%= apiBase %>" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="app-shell min-h-screen text-gray-900">
  <header class="sticky top-0 z-40 border-b border-gray-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <a href="/wiki" class="shrink-0 text-base font-semibold tracking-tight text-gray-900 no-underline">
        Aurora Labs Wiki
      </a>
      <nav class="flex flex-wrap items-center gap-1 rounded-full border border-gray-200 bg-gray-50/80 p-1 text-sm" aria-label="Main">
        <% const links = [
          {href: '/wiki', label: 'Wiki'},
          {href: '/dashboard', label: 'Dashboard'},
          {href: '/chat', label: 'Chat'},
          {href: '/emails', label: 'Emails'},
          {href: '/resources', label: 'Resources'},
          {href: '/graph', label: 'Graph'},
          {href: '/analytics', label: 'Analytics'},
        ]; %>
        <% links.forEach(function(link) { %>
          <a href="<%= link.href %>"
             class="rounded-full px-3 py-1.5 font-medium no-underline transition-colors <%= active === link.label ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-800' %>">
            <%= link.label %>
          </a>
        <% }); %>
      </nav>
    </div>
  </header>
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
