<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('dashboard.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%= t('dashboard.intro') %>
</p>

<div id="offline-banner" class="hidden mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700"></div>

<div id="stat-cards" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>

<div class="mt-6 flex flex-col gap-6">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-4">
      <div class="flex items-center gap-3">
        <h2 class="text-base font-semibold text-gray-900"><%= t('dashboard.run.title') %></h2>
        <span id="build-status-badge" class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600"><%= t('dashboard.badge.idle') %></span>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button aria-controls="sources-picker" aria-expanded="false" aria-haspopup="true" id="sources-picker-toggle" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"><%= t('dashboard.sourcesToInclude') %> <span id="sources-picker-count" class="text-xs text-gray-400"></span></button>
        <button aria-controls="run-options" aria-expanded="false" aria-haspopup="true" id="run-options-toggle" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"><%= t('dashboard.runOptions') %> <span id="run-options-count" class="text-xs text-gray-400"></span></button>
        <label class="flex items-center gap-2 text-sm text-gray-600" title="<%= t('dashboard.rebuildTitle') %>">
          <input id="force-rebuild" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
          <%= t('dashboard.rebuildAll') %>
        </label>
        <button id="stop-build" type="button" class="hidden inline-flex items-center justify-center gap-2 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50"><%= t('dashboard.stop') %></button>
        <button id="run-build" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-dark"><%= t('dashboard.run') %></button>
      </div>
    </div>
    <div id="sources-picker" class="hidden border-b border-gray-100 bg-gray-50 px-5 py-3">
      <p class="mb-2 text-xs text-gray-500"><%- t('dashboard.pickerHintHtml') %></p>
      <div id="sources-picker-list" class="flex flex-wrap gap-3 text-sm"></div>
    </div>
    <div id="run-options" class="hidden border-b border-gray-100 bg-gray-50 px-5 py-3">
      <p class="mb-2 text-xs text-gray-500"><%- t('dashboard.optionsHintHtml') %></p>
      <div class="flex flex-wrap items-start gap-4 text-sm">
        <label class="flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.criticTitle') %>">
          <input id="run-opt-critic-pass" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
          <%= t('dashboard.opt.critic') %>
        </label>
        <label id="run-opt-critic-samples-label" class="hidden flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.samplesTitle') %>">
          <%= t('dashboard.opt.samples') %>
          <input id="run-opt-critic-samples" type="number" min="1" max="9" value="1" class="w-14 rounded-md border border-gray-300 px-1.5 py-0.5 text-sm" />
        </label>
        <label id="run-opt-critic-regenerate-label" class="hidden flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.regenerateTitle') %>">
          <input id="run-opt-critic-regenerate" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
          <%= t('dashboard.opt.regenerate') %>
        </label>
        <label class="flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.correctionsTitle') %>">
          <input id="run-opt-use-corrections" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
          <%= t('dashboard.opt.corrections') %>
        </label>
        <label class="flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.piiTitle') %>">
          <input id="run-opt-redact-pii" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
          <%= t('dashboard.opt.pii') %>
        </label>
        <label class="flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.webTitle') %>">
          <input id="run-opt-web-search" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
          <%= t('dashboard.opt.web') %>
        </label>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-4 border-t border-gray-200 pt-3 text-sm">
        <label class="flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.defaultModelTitle') %>">
          <%= t('dashboard.opt.defaultModel') %>
          <select id="run-opt-default-model" class="rounded-md border border-gray-300 px-1.5 py-1 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20">
            <option value=""><%= t('dashboard.opt.defaultOption') %></option>
          </select>
        </label>
        <label class="flex items-center gap-2 text-gray-600" title="<%= t('dashboard.opt.thinkingModelTitle') %>">
          <%= t('dashboard.opt.thinkingModel') %>
          <select id="run-opt-thinking-model" class="rounded-md border border-gray-300 px-1.5 py-1 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20">
            <option value=""><%= t('dashboard.opt.defaultOption') %></option>
          </select>
        </label>
      </div>
    </div>
    <div class="p-4">
      <div id="build-steps" class="flex flex-col gap-1.5 md:flex-row md:items-stretch md:gap-2"></div>
      <p id="build-message" class="mt-2 text-xs text-gray-500"><%= t('dashboard.message.initial') %></p>
      <p class="mt-1 text-xs text-gray-400"><%= t('dashboard.resumeNote') %></p>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-4">
      <div>
        <h2 class="flex items-center gap-2 text-base font-semibold text-gray-900"><%= t('dashboard.sources.title') %></h2>
        <p id="sources-subtitle" class="mt-0.5 text-xs text-gray-500"><%= t('dashboard.sources.subtitle') %></p>
      </div>
      <button aria-controls="add-source-form" aria-expanded="false" aria-haspopup="true" id="add-source-toggle" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-source-border px-4 py-2 text-sm font-medium text-source hover:bg-source-bg"><%= t('dashboard.sources.add') %></button>
    </div>
    <div id="add-source-form" class="hidden border-b border-gray-100 p-5"></div>
    <div id="sources-grid" class="grid gap-3 p-5 sm:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900"><%= t('dashboard.files.title') %></h2>
      <p class="mt-0.5 text-sm text-gray-500"><%= t('dashboard.files.intro') %></p>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 px-5 py-2.5">
      <nav id="breadcrumbs" class="flex min-w-0 flex-wrap items-center gap-1 text-sm"></nav>
      <div class="flex items-center gap-2">
        <input aria-label="<%= t('dashboard.files.searchPh') %>" id="file-search" type="search" placeholder="<%= t('dashboard.files.searchPh') %>" class="w-40 rounded-lg border border-gray-300 px-2.5 py-1 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        <button aria-controls="new-folder-form" aria-expanded="false" aria-haspopup="true" id="new-folder-toggle" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('dashboard.files.newFolder') %></button>
        <button id="upload-files-toggle" type="button" title="<%= t('dashboard.files.uploadTitle') %>" class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-3 py-1 text-xs font-medium text-white hover:bg-accent-dark"><%= t('dashboard.files.upload') %></button>
        <input id="upload-files-input" type="file" multiple class="hidden" />
      </div>
    </div>
    <div id="new-folder-form" class="hidden mx-5 mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-3 py-2"></div>
    <div id="upload-status" class="hidden mx-5 mt-4 rounded-lg border border-dashed border-source-border bg-source-bg/60 px-3 py-2 text-xs text-source"></div>
    <div id="file-grid" data-dropzone class="grid grid-cols-3 gap-1 p-4 transition-colors sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8"></div>
  </section>
</div>

<div id="preview-modal" class="hidden"></div>

<%- include('partials/foot', { clientScript: 'dashboard' }) %>
