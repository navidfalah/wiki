<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('resources.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%= t('resources.intro') %>
</p>

<div class="mt-4 flex flex-wrap items-center gap-1 border-b border-gray-200">
  <button data-tab="files" class="resource-tab -mb-px border-b-2 border-accent px-3 py-2 text-sm font-medium text-accent"><%= t('resources.tab.files') %></button>
  <button data-tab="database" class="resource-tab -mb-px border-b-2 border-transparent px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700"><%= t('resources.tab.database') %></button>
  <button data-tab="connectors" class="resource-tab -mb-px border-b-2 border-transparent px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700"><%= t('resources.tab.connectors') %></button>
  <button data-tab="emails" class="resource-tab -mb-px border-b-2 border-transparent px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700"><%= t('resources.tab.emails') %></button>
</div>

<!-- ============================== Files ============================== -->
<div id="tab-panel-files" class="resource-panel mt-4">
  <p class="max-w-2xl text-sm text-gray-600">
    <%= t('resources.files.intro') %>
  </p>

  <section class="mt-4 rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 px-5 py-2.5">
      <nav id="breadcrumbs" class="flex min-w-0 flex-wrap items-center gap-1 text-sm"></nav>
      <div class="flex items-center gap-2">
        <input id="resource-search" type="search" placeholder="<%= t('resources.files.searchPh') %>" class="w-44 rounded-lg border border-gray-300 px-2.5 py-1 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
        <button id="new-folder-toggle" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('resources.files.newFolder') %></button>
        <button id="upload-files-toggle" type="button" title="<%= t('resources.files.uploadTitle') %>" class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-3 py-1 text-xs font-medium text-white hover:bg-accent-dark"><%= t('resources.files.upload') %></button>
        <input id="upload-files-input" type="file" multiple class="hidden" />
      </div>
    </div>
    <div id="new-folder-form" class="hidden mx-5 mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-3 py-2"></div>
    <div id="upload-status" class="hidden mx-5 mt-4 rounded-lg border border-dashed border-source-border bg-source-bg/60 px-3 py-2 text-xs text-source"></div>
    <div id="resource-grid" data-dropzone class="grid grid-cols-3 gap-1 p-4 transition-colors sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8"></div>
  </section>

  <div id="preview-modal" class="hidden"></div>
</div>

<!-- ============================= Database ============================= -->
<div id="tab-panel-database" class="resource-panel mt-4 hidden">
  <p class="max-w-2xl text-sm text-gray-600">
    <%- t('resources.db.introHtml') %>
    <% if (typeof showSampleDb === 'undefined' || showSampleDb) { %><%= t('resources.db.introSample') %><% } %>
  </p>

  <% if (typeof showSampleDb === 'undefined' || showSampleDb) { %>
  <div id="sample-db-callout" class="mt-4 rounded-xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-900">
    <p class="font-semibold"><%= t('resources.db.sampleTitle') %></p>
    <p class="mt-1 text-indigo-800">
      <%- t('resources.db.sampleBodyHtml') %>
    </p>
    <button type="button" id="use-sample-values-btn" class="mt-3 rounded-lg bg-indigo-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-indigo-800">
      <%= t('resources.db.sampleFill') %>
    </button>
    <p class="mt-2 text-xs text-indigo-700">
      <%- t('resources.db.sampleNoteHtml') %>
    </p>
  </div>
  <% } %>

  <section class="mt-4 rounded-xl border border-gray-200 bg-white p-4 shadow-card">
    <h2 class="text-sm font-semibold text-gray-900"><%= t('resources.db.connectTitle') %></h2>
    <form id="connect-form" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.label') %>
        <input name="account_label" type="text" required placeholder="<%= t('resources.db.labelPh') %>" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.host') %>
        <input name="host" type="text" required placeholder="localhost" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.port') %>
        <input name="port" type="number" value="5432" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.database') %>
        <input name="dbname" type="text" required placeholder="aurora_kb" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.user') %>
        <input name="user" type="text" required placeholder="wiki_reader" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.schema') %>
        <input name="schema" type="text" value="public" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.password') %>
        <input name="password" type="password" required class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <div class="flex items-end">
        <button type="submit" class="rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-800"><%= t('resources.db.connect') %></button>
      </div>
    </form>
    <p id="connect-error" class="mt-2 hidden text-xs text-red-600"></p>
  </section>

  <section class="mt-4 rounded-xl border border-gray-200 bg-white p-4 shadow-card">
    <h2 class="text-sm font-semibold text-gray-900"><%= t('resources.sqlite.title') %></h2>
    <p class="mt-1 text-xs text-gray-500">
      <%- t('resources.sqlite.hintHtml') %>
    </p>
    <form id="connect-sqlite-form" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600"><%= t('resources.db.label') %>
        <input name="account_label" type="text" required placeholder="<%= t('resources.sqlite.labelPh') %>" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-gray-600 sm:col-span-2 lg:col-span-2"><%= t('resources.sqlite.filePath') %>
        <input name="db_path" type="text" required placeholder="/path/to/database.sqlite" class="rounded-lg border border-gray-300 px-2 py-1.5 text-sm" />
      </label>
      <div class="flex items-end">
        <button type="submit" class="rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-800"><%= t('resources.db.connect') %></button>
      </div>
    </form>
    <p id="connect-sqlite-error" class="mt-2 hidden text-xs text-red-600"></p>
  </section>

  <section class="mt-4">
    <h2 class="text-sm font-semibold text-gray-900"><%= t('resources.accounts.title') %></h2>
    <div id="accounts-list" class="mt-3 flex flex-col gap-4"></div>
  </section>

  <section class="mt-4">
    <div class="flex items-center gap-2">
      <h2 class="text-sm font-semibold text-gray-900"><%= t('resources.activity.title') %></h2>
      <span id="activity-status" class="text-xs text-gray-500"></span>
      <button id="activity-refresh" type="button" class="ml-auto inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50"><%= t('common.refresh') %></button>
    </div>
    <p class="mt-1 max-w-2xl text-sm text-gray-600">
      <%= t('resources.activity.intro') %>
    </p>
    <div class="mt-3 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-card">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-100 bg-gray-50 text-xs text-gray-500">
          <tr>
            <th class="px-4 py-2.5 font-medium"><%= t('resources.activity.th.when') %></th>
            <th class="px-4 py-2.5 font-medium"><%= t('resources.activity.th.user') %></th>
            <th class="px-4 py-2.5 font-medium"><%= t('resources.activity.th.account') %></th>
            <th class="px-4 py-2.5 font-medium"><%= t('resources.activity.th.action') %></th>
            <th class="px-4 py-2.5 font-medium"><%= t('resources.activity.th.detail') %></th>
            <th class="px-4 py-2.5 font-medium"><%= t('resources.activity.th.duration') %></th>
          </tr>
        </thead>
        <tbody id="activity-body" class="divide-y divide-gray-100"></tbody>
      </table>
    </div>
  </section>
</div>

<!-- ============================ Connectors ============================ -->
<div id="tab-panel-connectors" class="resource-panel mt-4 hidden">
  <p class="max-w-2xl text-sm text-gray-600">
    <%- t('resources.connectors.introHtml').replace('{link}', '<button type="button" data-tab-link="database" class="font-medium text-accent underline">' + t('resources.tab.database') + '</button>') %>
  </p>

  <div id="connectors-list" class="mt-4 flex flex-col gap-4"></div>
</div>

<!-- ============================== Emails =============================== -->
<div id="tab-panel-emails" class="resource-panel mt-4 hidden">
  <div class="flex items-start justify-between gap-4">
    <p class="max-w-2xl text-sm text-gray-600"><%= t('resources.emails.intro') %></p>
    <button id="add-email" class="shrink-0 rounded-lg bg-accent px-3 py-2 text-sm font-medium text-white hover:bg-accent-dark">
      <%= t('resources.emails.add') %>
    </button>
  </div>

  <div id="emails-list" class="mt-4 grid gap-3">
    <p class="text-sm text-gray-500"><%= t('common.loading') %></p>
  </div>

  <div id="email-modal" class="hidden"></div>
</div>

<%- include('partials/foot', { clientScript }) %>
