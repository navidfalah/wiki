<%- include('partials/head', { title, apiBase, active }) %>

<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-gray-900">Pipelines</h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-600">History of compiler runs, step by step.</p>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <span id="pipeline-build-badge" class="hidden inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">Running…</span>
    <label class="flex items-center gap-2 text-sm text-gray-600" title="Off: only new/changed files are (re)processed, resuming where the last run left off. On: every file is reprocessed from scratch.">
      <input id="pipeline-force-rebuild" type="checkbox" class="rounded border-gray-300 text-accent focus:ring-accent/30" />
      Rebuild all files
    </label>
    <button id="pipeline-stop-build" type="button" class="hidden inline-flex items-center justify-center gap-2 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50">Stop</button>
    <button id="pipeline-run-build" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-dark">Run compiler</button>
  </div>
</div>
<p id="pipeline-build-message" class="mt-1 text-xs text-gray-500"></p>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900">Runs</h2>
    </div>
    <div id="pipeline-runs-list" class="divide-y divide-gray-100">
      <p class="p-5 text-sm text-gray-500">Loading…</p>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900">Run detail</h2>
    </div>
    <div id="pipeline-run-detail" class="p-5">
      <p class="text-sm text-gray-500">Select a run to see its steps.</p>
    </div>
  </section>
</div>

<%- include('partials/foot', { clientScript }) %>
