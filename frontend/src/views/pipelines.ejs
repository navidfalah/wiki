<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Pipelines</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">History of compiler runs, step by step.</p>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900">Runs</h2>
    </div>
    <div id="pipeline-runs-list" class="divide-y divide-gray-100">
      <p class="p-5 text-sm text-gray-500">Loading…</p>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900">Run detail</h2>
    </div>
    <div id="pipeline-run-detail" class="p-5">
      <p class="text-sm text-gray-500">Select a run to see its steps.</p>
    </div>
  </section>
</div>

<%- include('partials/foot', { clientScript }) %>
