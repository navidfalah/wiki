<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Finish connecting <%= connectorLabel %></h1>
<p class="mt-1 max-w-lg text-sm text-gray-600">
  The provider sent you back here with an authorization code. Give this account a label
  (usually the email address) so it's stored under a name you'll recognize, then finish.
</p>

<div id="callback-error" class="mt-4 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>

<form id="callback-form" class="mt-6 flex max-w-sm flex-col gap-3">
  <label class="flex flex-col gap-1 text-xs font-medium text-gray-600">
    Account label
    <input name="account_label" type="text" placeholder="me@example.com" required class="rounded-lg border border-gray-300 px-3 py-2 text-sm" />
  </label>
  <button type="submit" class="rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-800">Finish connecting</button>
</form>

<script>
  window.__connectorId = <%- JSON.stringify(connectorId) %>;
</script>

<%- include('partials/foot', { clientScript }) %>
