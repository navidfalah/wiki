<%- include('partials/head', { title, apiBase, active }) %>

<nav class="text-sm text-gray-500">
  <a href="/wiki" class="text-gray-500 no-underline hover:text-accent">Wiki</a>
  <span class="mx-1">/</span>
  <span class="text-gray-700"><%= doc.title %></span>
</nav>

<div class="mt-2 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= doc.title %></h1>
    <% if (doc.tags && doc.tags.length) { %>
      <div class="mt-2 flex flex-wrap gap-1.5">
        <% doc.tags.forEach(function(tag) { %>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600"><%= tag %></span>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="flex shrink-0 gap-2">
    <a href="/wiki/<%= slug %>/edit"
       class="flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 no-underline hover:bg-gray-50">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"></path></svg>
      Edit
    </a>
    <a href="/wiki/<%= slug %>/download"
       class="flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 no-underline hover:bg-gray-50">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      Download
    </a>
    <button
      type="button"
      id="wiki-delete-btn"
      data-slug="<%= slug %>"
      data-title="<%= doc.title %>"
      class="flex items-center gap-1.5 rounded-lg border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
      Delete
    </button>
  </div>
</div>

<pre class="mt-6 max-w-none overflow-x-auto whitespace-pre-wrap break-words rounded-xl border border-gray-200 bg-white p-5 text-sm leading-relaxed text-gray-800 shadow-card"><%= doc.body %></pre>

<% if (doc.links && doc.links.length) { %>
  <div class="mt-6">
    <h2 class="text-sm font-semibold text-gray-700">Linked pages</h2>
    <div class="mt-2 flex flex-wrap gap-2">
      <% doc.links.forEach(function(link) { %>
        <span class="rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs text-gray-600"><%= link.text %></span>
      <% }); %>
    </div>
  </div>
<% } %>

<script>
  (function () {
    var apiBase = document.querySelector('meta[name="api-base"]')?.getAttribute('content') ?? '';
    var btn = document.getElementById('wiki-delete-btn');
    btn.addEventListener('click', async function () {
      var slug = btn.dataset.slug;
      var title = btn.dataset.title;
      if (!confirm('Delete "' + title + '"? This cannot be undone.')) return;
      btn.disabled = true;
      try {
        var res = await fetch(apiBase + '/api/docs/' + slug + '.md', { method: 'DELETE' });
        if (!res.ok) throw new Error('Delete failed (' + res.status + ')');
        window.queueToast('Deleted "' + title + '"', 'success');
        window.location.href = '/wiki';
      } catch (err) {
        window.showToast(err.message || 'Failed to delete page.', 'error');
        btn.disabled = false;
      }
    });
  })();
</script>

<%- include('partials/foot', { clientScript: null }) %>
