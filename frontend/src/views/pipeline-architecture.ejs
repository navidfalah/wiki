<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('pipeline-architecture.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%- t('pipeline-architecture.introHtml') %>
</p>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900"><%= t('pipeline-architecture.stages') %></h2>
      <p class="mt-0.5 text-xs text-gray-500"><%= t('pipeline-architecture.stagesHint') %></p>
    </div>

    <div class="flex flex-col divide-y divide-gray-100">
      <label class="flex items-start gap-3 px-5 py-4">
        <input data-field="critic_pass" type="checkbox" class="mt-0.5 rounded border-gray-300 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('pipeline-architecture.critic') %></span>
          <span class="block text-xs text-gray-500"><%= t('pipeline-architecture.criticHint') %></span>
        </span>
      </label>

      <div id="critic-suboptions" class="hidden flex-col gap-4 bg-gray-50 px-5 py-4 pl-11">
        <label class="flex flex-col gap-1 max-w-xs">
          <span class="text-xs font-medium text-gray-600"><%= t('pipeline-architecture.criticSamples') %></span>
          <input data-field="critic_samples" type="number" min="1" step="1" class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
          <span class="text-xs text-gray-500"><%= t('pipeline-architecture.criticSamplesHint') %></span>
        </label>
        <label class="flex items-start gap-3">
          <input data-field="critic_regenerate" type="checkbox" class="mt-0.5 rounded border-gray-300 text-accent focus:ring-accent/30" />
          <span>
            <span class="block text-sm font-medium text-gray-900"><%= t('pipeline-architecture.regenerate') %></span>
            <span class="block text-xs text-gray-500"><%= t('pipeline-architecture.regenerateHint') %></span>
          </span>
        </label>
      </div>

      <label class="flex items-start gap-3 px-5 py-4">
        <input data-field="use_corrections" type="checkbox" class="mt-0.5 rounded border-gray-300 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('pipeline-architecture.corrections') %></span>
          <span class="block text-xs text-gray-500"><%= t('pipeline-architecture.correctionsHint') %></span>
        </span>
      </label>

      <label class="flex items-start gap-3 px-5 py-4">
        <input data-field="redact_pii" type="checkbox" class="mt-0.5 rounded border-gray-300 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('pipeline-architecture.pii') %></span>
          <span class="block text-xs text-gray-500"><%= t('pipeline-architecture.piiHint') %></span>
        </span>
      </label>

      <label class="flex items-start gap-3 px-5 py-4">
        <input data-field="web_search" type="checkbox" class="mt-0.5 rounded border-gray-300 text-accent focus:ring-accent/30" />
        <span>
          <span class="block text-sm font-medium text-gray-900"><%= t('pipeline-architecture.web') %></span>
          <span class="block text-xs text-gray-500"><%- t('pipeline-architecture.webHintHtml') %></span>
        </span>
      </label>
    </div>

    <div class="flex items-center justify-between border-t border-gray-100 px-5 py-4">
      <p id="pipeline-arch-saved-hint" class="text-xs text-gray-400"></p>
      <button id="save-pipeline-arch-btn" type="button" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-dark">
        <%= t('common.save') %>
      </button>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-card">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-base font-semibold text-gray-900"><%= t('pipeline-architecture.sources') %></h2>
      <p class="mt-0.5 text-xs text-gray-500">
        <%- t('pipeline-architecture.sourcesHintHtml') %>
      </p>
    </div>
    <div id="pipeline-arch-folders" class="flex flex-col divide-y divide-gray-100">
      <p class="p-5 text-sm text-gray-500"><%= t('common.loading') %></p>
    </div>
  </section>
</div>

<%- include('partials/foot', { clientScript }) %>
