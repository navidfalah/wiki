<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900">Topic Graph</h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  Every topic and the pages it links to. Node size and color track how connected a topic is —
  bigger, warmer nodes are hubs. Hover a node to inspect it, drag to rearrange, scroll to zoom,
  <strong class="font-medium text-gray-700">click a node to select it</strong> for export.
</p>

<div id="graph-stats" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>

<div class="mt-4 rounded-xl border border-gray-200 bg-white p-3 shadow-card">
  <div class="flex flex-wrap items-center gap-2">
    <div class="relative flex-1 min-w-[220px] max-w-sm">
      <input id="graph-search" type="search" placeholder="Search topics…"
        class="w-full rounded-lg border border-gray-300 py-1.5 pl-8 pr-3 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
      <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </div>
    <button id="graph-select-matches" type="button" disabled
      class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40">
      Select matches
    </button>
    <button id="graph-fit" type="button"
      class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">⤢ Fit view</button>

    <div class="ml-auto flex flex-wrap items-center gap-3 text-xs text-gray-500">
      <span class="flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full bg-generated-border"></span>Few links</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-full bg-generated"></span>Well connected</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded-full bg-source"></span>Hub</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-2.5 w-4 rounded-sm bg-amber-400"></span>Manual link</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-full border-2 border-accent bg-white"></span>Selected</span>
    </div>
  </div>

  <div id="graph-hubs" class="mt-3 flex flex-wrap items-center gap-1.5 text-xs"></div>
</div>

<div id="graph-selection-bar" class="mt-3 hidden items-center gap-3 rounded-xl border border-accent/30 bg-accent/5 px-4 py-2.5">
  <span id="graph-selection-count" class="shrink-0 text-sm font-medium text-gray-800"></span>
  <div id="graph-selection-chips" class="flex min-w-0 flex-1 flex-wrap gap-1.5"></div>
  <div class="ml-auto flex shrink-0 items-center gap-2">
    <button id="graph-selection-clear" type="button"
      class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50">Clear</button>
    <button id="graph-selection-export" type="button"
      class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-3 py-1.5 text-xs font-medium text-white hover:opacity-90">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span id="graph-selection-export-label">Export</span>
    </button>
  </div>
</div>

<div id="graph-empty" class="mt-4 hidden rounded-lg border border-gray-200 bg-white p-8 text-center text-sm text-gray-500"></div>

<div class="relative mt-4">
  <div id="graph-canvas" class="relative h-[80vh] min-h-[560px] w-full overflow-hidden rounded-xl border border-gray-200 bg-white shadow-card"></div>
  <div id="graph-inspector" class="pointer-events-none absolute right-3 top-3 hidden w-72 max-w-[85%] rounded-xl border border-gray-200 bg-white/95 p-4 shadow-panel backdrop-blur-sm"></div>
</div>

<%- include('partials/foot', { clientScript }) %>
