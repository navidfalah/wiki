<%
  const svg = (inner, size) => `<svg viewBox="0 0 24 24" width="${size || 22}" height="${size || 22}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
  const icons = {
    files: svg('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/>'),
    wiki: svg('<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>'),
    chat: svg('<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/>'),
    graph: svg('<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="8" r="2.5"/><circle cx="12" cy="18" r="2.5"/><line x1="8" y1="7" x2="16" y2="7.6"/><line x1="7" y1="8.2" x2="11" y2="15.6"/><line x1="17" y1="10.3" x2="13" y2="15.7"/>'),
    plug: svg('<path d="M9 2v6"/><path d="M15 2v6"/><path d="M6 8h12v4a6 6 0 0 1-12 0z"/><path d="M12 18v4"/>'),
    shield: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>'),
  };
  const check = svg('<polyline points="20 6 9 17 4 12"/>', 18);
  const arrow = svg('<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>', 18);
  const loginHref = signedIn ? '/dashboard' : '/login';
  const loginLabel = signedIn ? t.nav.dashboard : t.nav.login;
%><!doctype html>
<html lang="<%= t.htmlLang %>" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= t.metaTitle %></title>
  <meta name="description" content="<%= t.metaDescription %>" />
  <link rel="canonical" href="<%= canonical %>" />
  <link rel="alternate" hreflang="de" href="<%= siteUrl %>/" />
  <link rel="alternate" hreflang="en" href="<%= siteUrl %>/en" />
  <link rel="alternate" hreflang="x-default" href="<%= siteUrl %>/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Wissensbau" />
  <meta property="og:title" content="<%= t.metaTitle %>" />
  <meta property="og:description" content="<%= t.metaDescription %>" />
  <meta property="og:url" content="<%= canonical %>" />
  <meta name="theme-color" content="#059669" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <%- include('partials/fonts') %>
  <link rel="stylesheet" href="/css/app.css?v=<%= assetV %>" />
</head>
<body class="bg-white font-sans text-slate-800 antialiased">

  <!-- Top bar -->
  <header class="sticky top-0 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
      <a href="<%= lang === 'de' ? '/' : '/en' %>?design=a" class="flex items-center gap-2.5 no-underline">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent shadow-sm">
          <svg viewBox="0 0 32 32" width="20" height="20" aria-hidden="true"><g fill="#fff"><rect x="6" y="19" width="9" height="7" rx="1.5"/><rect x="17" y="19" width="9" height="7" rx="1.5"/><rect x="11.5" y="8" width="9" height="9" rx="1.5" opacity=".85"/></g></svg>
        </span>
        <span class="text-lg font-semibold tracking-tight text-slate-900">Wissensbau</span>
      </a>
      <nav class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex" aria-label="Main">
        <a href="#funktionen" class="no-underline hover:text-slate-900"><%= t.nav.features %></a>
        <a href="#ablauf" class="no-underline hover:text-slate-900"><%= t.nav.how %></a>
        <a href="#betrieb" class="no-underline hover:text-slate-900"><%= t.nav.ops %></a>
      </nav>
      <div class="flex items-center gap-2">
        <a href="/lang/<%= lang === 'de' ? 'en' : 'de' %>?next=<%= encodeURIComponent(t.nav.switchHref + '?design=a') %>" hreflang="<%= lang === 'de' ? 'en' : 'de' %>" class="rounded-md px-2 py-1 text-xs font-semibold text-slate-500 no-underline hover:bg-slate-100 hover:text-slate-800"><%= t.nav.switchLabel %></a>
        <a href="<%= loginHref %>" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white no-underline transition hover:bg-slate-700"><%= loginLabel %></a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -top-32 left-1/2 h-[34rem] w-[54rem] -translate-x-1/2 rounded-full bg-gradient-to-br from-emerald-200/70 via-teal-100/60 to-sky-100/50 blur-3xl"></div>
        <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(15,23,42,0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.045)_1px,transparent_1px)] [background-size:44px_44px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_72%)]"></div>
      </div>

      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-16 md:pb-28 md:pt-24 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="animate-rise">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><%= t.hero.badge %>
          </span>
          <h1 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight text-slate-900 sm:text-5xl lg:text-[3.4rem]">
            <%= t.hero.titleLead %>
            <span class="bg-gradient-to-r from-emerald-600 to-teal-500 bg-clip-text text-transparent"><%= t.hero.titleAccent %></span>
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600"><%= t.hero.text %></p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="<%= loginHref %>" class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white no-underline shadow-lg shadow-emerald-600/20 transition hover:bg-accent-dark">
              <%= signedIn ? t.nav.dashboard : t.hero.ctaPrimary %> <%- arrow %>
            </a>
            <a href="#ablauf" class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 no-underline transition hover:border-slate-400 hover:bg-slate-50"><%= t.hero.ctaSecondary %></a>
          </div>
          <p class="mt-6 text-xs font-medium tracking-wide text-slate-400"><%= t.hero.formats %></p>
        </div>

        <!-- Decorative product mock -->
        <div class="relative mx-auto w-full max-w-md animate-float motion-reduce:animate-none" aria-hidden="true">
          <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-tr from-emerald-300/30 to-sky-300/30 blur-2xl"></div>
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-panel">
            <div class="flex items-center gap-1.5 border-b border-slate-100 bg-slate-50 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span><span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span><span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
              <span class="ml-3 truncate text-[11px] text-slate-400"><%= t.mock.page %></span>
            </div>
            <div class="space-y-4 p-5">
              <div class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-slate-900 px-4 py-2.5 text-sm text-white"><%= t.mock.question %></div>
              <div class="max-w-[92%] rounded-2xl rounded-bl-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                <p><%= t.mock.answer %></p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  <% t.mock.sources.forEach(function(source, i) { %>
                    <span class="inline-flex items-center gap-1 rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700"><span class="opacity-60">[<%= i + 1 %>]</span> <%= source %></span>
                  <% }); %>
                </div>
              </div>
              <div class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs text-slate-400">
                <span class="h-4 w-0.5 animate-pulse bg-emerald-500"></span>…
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="ablauf" class="scroll-mt-20 border-y border-slate-200 bg-slate-50/70 py-20">
      <div class="mx-auto max-w-6xl px-5">
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-600"><%= t.how.eyebrow %></p>
        <h2 class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"><%= t.how.title %></h2>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <% t.how.steps.forEach(function(step, i) { %>
            <li class="relative rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-sm font-semibold text-emerald-700 ring-1 ring-emerald-200"><%= i + 1 %></span>
              <h3 class="mt-4 text-lg font-semibold text-slate-900"><%= step.title %></h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= step.text %></p>
            </li>
          <% }); %>
        </ol>
      </div>
    </section>

    <!-- Features -->
    <section id="funktionen" class="scroll-mt-20 py-20">
      <div class="mx-auto max-w-6xl px-5">
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-600"><%= t.features.eyebrow %></p>
        <h2 class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"><%= t.features.title %></h2>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <% t.features.items.forEach(function(item) { %>
            <article class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-panel">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 transition group-hover:bg-emerald-600 group-hover:text-white"><%- icons[item.icon] %></span>
              <h3 class="mt-4 text-base font-semibold text-slate-900"><%= item.title %></h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= item.text %></p>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Operations -->
    <section id="betrieb" class="scroll-mt-20 px-5 pb-20">
      <div class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-slate-900 px-6 py-14 sm:px-12">
        <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative grid gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-emerald-400"><%= t.ops.eyebrow %></p>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl"><%= t.ops.title %></h2>
            <p class="mt-4 max-w-lg leading-relaxed text-slate-300"><%= t.ops.text %></p>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2">
            <% t.ops.points.forEach(function(point) { %>
              <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-200">
                <span class="mt-0.5 shrink-0 text-emerald-400"><%- check %></span><%= point %>
              </li>
            <% }); %>
          </ul>
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="px-5 pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"><%= t.cta.title %></h2>
        <p class="mt-3 text-slate-600"><%= t.cta.text %></p>
        <a href="<%= loginHref %>" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white no-underline shadow-lg shadow-emerald-600/20 transition hover:bg-accent-dark">
          <%= signedIn ? t.nav.dashboard : t.cta.button %> <%- arrow %>
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-8 text-sm text-slate-500 sm:flex-row">
      <p><span class="font-semibold text-slate-700">Wissensbau</span> · wissensbau.de · <%= t.footer.tagline %> <span class="opacity-70"><%= t.footer.note %></span></p>
      <p class="flex items-center gap-4">
        <% if (imprintUrl) { %><a href="<%= imprintUrl %>" class="no-underline hover:text-slate-800"><%= t.footer.imprint %></a><% } %>
        <% if (privacyUrl) { %><a href="<%= privacyUrl %>" class="no-underline hover:text-slate-800"><%= t.footer.privacy %></a><% } %>
        <span>© <%= year %></span>
      </p>
    </div>
  </footer>
</body>
</html>
