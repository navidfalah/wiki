<%- include('partials/head', { title, apiBase, active }) %>

<h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= t('entities.title') %></h1>
<p class="mt-1 max-w-2xl text-sm text-gray-600">
  <%- t('entities.introHtml') %>
</p>

<div id="entities-cards" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>

<div class="mt-6 flex flex-wrap items-center gap-2">
  <input id="entities-search" type="text" placeholder="<%= t('entities.filterPlaceholder') %>" class="w-64 rounded-lg border border-gray-300 px-3 py-1.5 text-sm" />
  <button id="entities-refresh" type="button" class="ml-auto inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"><%= t('entities.refresh') %></button>
</div>

<div id="entities-empty" class="mt-4 hidden rounded-xl border border-gray-200 bg-white p-8 text-center text-sm text-gray-500"></div>

<div id="entities-list" class="mt-4 flex flex-col gap-2"></div>

<%- include('partials/foot', { clientScript }) %>
