{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "moduleDetection": "force"
  },
  "include": [
    "src/client/**/*.ts"
  ],
  "exclude": [
    "src/client/graph.ts"
  ]
}
