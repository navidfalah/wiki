{
  "version": 1,
  "default_by_source_type": {
    "text": "medium",
    "email": "medium",
    "image": "low",
    "file": "medium"
  },
  "rules": [
    {
      "pattern": "meetings/*minutes*",
      "level": "high",
      "reason": "Official board minutes"
    },
    {
      "pattern": "meetings/*protokoll*",
      "level": "high",
      "reason": "Official general assembly minutes"
    },
    {
      "pattern": "monitoring/**",
      "level": "high",
      "reason": "Machine-generated measurement data from the plant"
    },
    {
      "pattern": "public/**",
      "level": "low",
      "reason": "Public marketing material, not kept up to date"
    }
  ]
}
